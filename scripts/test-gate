#!/usr/bin/env bash
# Run the Gate Context node offline against a set of scenarios.
#
#   ./scripts/test-gate workflows/project-jessie-v86.json
#
# Gate Context is one big Code node that every message passes through, so a
# syntax or scope error there takes Jessie down completely rather than
# degrading one feature. That has happened twice: the v74 apostrophe, and a
# v86 draft that redeclared `found` and threw on every single message.
#
# This extracts the node's jsCode, stubs the n8n globals it reads, and runs it
# against the cases below. It checks the node executes and reports what it
# decided - it does not check the model does anything sensible with that.
set -euo pipefail
src="${1:?usage: test-gate <workflow.json>}"
here="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

python3 - "$src" "$tmp/gate.js" <<'PY'
import json, sys
w = json.load(open(sys.argv[1]))
n = [x for x in w["nodes"] if x["name"] == "Gate Context"]
if not n:
    sys.exit("no Gate Context node in " + sys.argv[1])
open(sys.argv[2], "w").write(n[0]["parameters"]["jsCode"])
PY

cat > "$tmp/run.js" <<'JS'
const src = require('fs').readFileSync(process.argv[2], 'utf8');
const DEFAULT_NOW = Date.UTC(2026, 7, 30, 8, 20, 0); // Sun 30 Aug 2026, 16:20 Manila (Jessie: Sun 30 Aug 2027)
Date.now = () => DEFAULT_NOW;
const ME = 'U026N6E1R';
const store = {};
const run = (text, history) => {
  const $ = name => ({
    first: () => ({ json:
      name === 'Slack Trigger' ? { text, user: ME, ts: '1788077500.1', channel: 'D0BNZQ6M9PV' } :
      name === 'Get Booker'    ? { fields: { Name: 'Tara Lim', Department: ['Audio Post'] } } : {} }),
    all: () => history.map(h => ({ json: h }))
  });
  return new Function('$', '$getWorkflowStaticData', src)($, () => store)[0].json;
};
const bot = t => ({ text: t, bot_id: 'B1', ts: '1788077400.1' });
const usr = t => ({ text: t, user: ME, ts: '1788077450.1' });
const bookSummary = bot('*Room:* Studio F\n\nConfirm to book. (yes/no)');
const cancelSummary = bot('MERMAID / X / KSC\n\nConfirm to cancel. (yes/no)');

// label, message, history, expectations
const cases = [
  ['fresh booking request',  'Book Studio F for Howard next Thursday from 1pm to 4pm', [],
   { confirmed: false, dateNotice: /Thursday, 9 September 2027/ }],
  ['this vs next',           'book studio 3 this Thursday 10am', [],
   { dateNotice: /Thursday, 2 September 2027/ }],
  ['bare weekday',           'book studio 3 Thursday 10am', [],
   { dateNotice: /the next one/ }],
  ['tomorrow',               'book the M booth tomorrow', [],
   { dateNotice: /Tuesday, 31 August 2027/ }],
  // A start time and no end. The model invented a 3-hour session from "at 2pm"
  // on 2026-08-30 and never said it had assumed anything.
  ['start time with no end',  'book a voiceover session next thursday at 2pm', [],
   { startOnlyNotice: /START TIME AND NO END/ }],
  ['a full range says nothing', 'book studio 7 next thursday 2pm to 5pm', [],
   { startOnlyNotice: '' }],
  ['a dashed range says nothing', 'book studio 7 next thursday 2pm-5pm', [],
   { startOnlyNotice: '' }],
  // v167 (eval 2026-09-28): "10am-12nn" was read as a start alone and booked 10-11.
  ['"10am-12nn" is a range', 'book studio 7 next friday 10am-12nn', [],
   { startOnlyNotice: '' }],
  ['"11am to 12 noon" is a range', 'book studio 7 next friday 11am to 12 noon', [],
   { startOnlyNotice: '' }],
  ['no time at all says nothing', 'book studio 7 next thursday', [],
   { startOnlyNotice: '' }],
  // The flag has to survive the turns between "at 2pm" and the summary. It did
  // not on 2026-08-30: she asked about a booth first, and the summary that
  // followed assumed an hour without saying so. These run in order — the first
  // raises it, the second is a reply carrying no time at all and must still
  // have it, the third supplies a length and must clear it.
  ['"at 12nn" alone is still a start', 'book studio 7 next friday at 12nn', [],
   { startOnlyNotice: /START TIME AND NO END/ }],
  ['start-only is raised', 'book a VO session next thursday at 2pm', [],
   { startOnlyNotice: /START TIME AND NO END/ }],
  ['and survives a reply with no time', 'just studio 7, no booth', [],
   { startOnlyNotice: /START TIME AND NO END/ }],
  ['an explicit length clears it', 'make it 3 hours', [],
   { startOnlyNotice: '' }],
  // v183 (QA N2): a new time after a summary with a range is a change, not a start time on its own
  ['"make it 3pm instead" after a 2-4 PM summary is not start-only', 'actually make it 3pm instead',
   [usr('actually make it 3pm instead'), bot('*ORBIT / Jem Lim / TL*\n*Time:* 2:00 PM – 4:00 PM\n\nBook it? Reply yes or no.')],
   { startOnlyNotice: '' }],
  ['y approves a booking',   'y', [usr('y'), bookSummary],
   { confirmed: true, confirmedCancel: false }],
  ['n refuses a booking',    'n', [usr('n'), bookSummary],
   { confirmed: false, declineNotice: /SAID NO/ }],
  ['y approves a cancel',    'y', [usr('y'), cancelSummary],
   { confirmedCancel: true, cancelNotice: /^NOTHING HAS BEEN CANCELLED YET[\s\S]*several bookings[\s\S]*call Prepare Cancel/ }],
  // the old suffix still sits in Slack history after the change, so it has to
  // keep working or the first confirmation after the import fails
  ['legacy (y/n) marker',    'yes', [usr('yes'), bot('*Room:* Studio F\n\nConfirm to book. (y/n)')],
   { confirmed: true }],
  ['y approves a move',      'y', [usr('y'), bot('ALPHA / X / TL\n\nConfirm to move. (yes/no)')],
   { confirmedMove: true, confirmed: false, confirmedCancel: false, moveNotice: /MOVE IS ALREADY APPROVED/ }],
  ['n refuses a move',       'n', [usr('n'), bot('ALPHA / X / TL\n\nConfirm to move. (yes/no)')],
   { confirmedMove: false, declineNotice: /SAID NO/ }],
  // 29 Sep QA bug 16: a weekday with "next week" is next week's day (today in these tests: Mon 30 Aug 2027).
  ['"Friday next week" is next week\'s Friday', 'book studio 3 Friday next week 2-4pm', [],
   { dateNotice: /^(?![\s\S]*3 September)[\s\S]*Friday, 10 September 2027/ }],
  ['"next week Friday" is next week\'s Friday', 'book studio 3 next week Friday 2-4pm', [],
   { dateNotice: /^(?![\s\S]*3 September)[\s\S]*Friday, 10 September 2027/ }],
  ['"every Tuesday" is a pattern, not a date', 'Book Studio 7 every Tuesday in November 10am to 12nn', [],
   { dateNotice: /^(?![\s\S]*Tuesday, 31 August)(?![\s\S]*Tuesday, 7 September)/ }],
  // QA bug 18: a yes to a series summary says the next action is Book Series.
  ['a yes to a series summary -> series notice', 'yes', [usr('yes'), bot('*QATESTSR / Jem Lim / TL*\n Dates:\n - November 2, 2027 (Tue)\n - November 9, 2027 (Tue)\n Time: 10:00 AM – 12:00 PM\n\nBook it? Reply yes or no.')],
   { confirmed: true, seriesNotice: /SERIES IS ALREADY APPROVED/ }],
  ['a yes to a series summary with the dates on one line -> series notice', 'yes', [usr('yes'), bot('*QATESTSR2 / Jem Lim / TL*\n Dates: November 2, 2027 (Tue), November 9, 2027 (Tue), November 16, 2027 (Tue)\n Time: 10:00 AM – 12:00 PM\n\nBook it? Reply yes or no.')],
   { confirmed: true, seriesNotice: /SERIES IS ALREADY APPROVED/ }],
  ['a yes to a series summary with short dates -> series notice', 'yes', [usr('yes'), bot('*QATESTSR3 / Jem Lim / TL*\n Dates: Dec 7 (Tue), Dec 14 (Tue), Dec 21 (Tue)\n Time: 10:00 AM – 12:00 PM\n\nBook it? Reply yes or no.')],
   { confirmed: true, seriesNotice: /SERIES IS ALREADY APPROVED/ }],
  ['a yes to a single summary -> no series notice', 'yes', [usr('yes'), bookSummary],
   { confirmed: true, seriesNotice: /^$/ }],
  // 29 Sep: the one-line confirmation. Both forms must confirm; the old one stays in Slack history for a while.
  ['one-line marker approves a booking', 'yes', [usr('yes'), bot('*Room:* Studio F\n\nBook it? Reply yes or no.')],
   { confirmed: true, confirmedCancel: false, confirmedMove: false }],
  ['one-line marker approves a cancel',  'yes', [usr('yes'), bot('*MERMAID / X / KSC*\n_check 1234abcd_\n\nCancel it? Reply yes or no.')],
   { confirmedCancel: true, confirmed: false, cancelNotice: /^NOTHING HAS BEEN CANCELLED\. [\s\S]*Prepare Cancel again[\s\S]*Do not call Cancel Booking/ }],
  ['one-line marker approves a move',    'y', [usr('y'), bot('ALPHA / X / TL\n\nMove it? Reply yes or no.')],
   { confirmedMove: true, confirmed: false, confirmedCancel: false }],
  ['no to the one-line marker',          'no', [usr('no'), bot('*Room:* Studio F\n\nBook it? Reply yes or no.')],
   { confirmed: false, declineNotice: /SAID NO/ }],
  ['a conditional yes to the one-line marker', 'yes but only after 5pm', [usr('x'), bot('*Room:* Studio F\n\nBook it? Reply yes or no.')],
   { confirmed: false }],
  ['the question mid-message is not a marker', 'yes', [usr('yes'), bot('Book it? Reply yes or no. Actually, which room did you want?')],
   { confirmed: false }],
  ['a change is not a yes',  'yes but move it to 3pm', [usr('x'), bookSummary],
   { confirmed: false }],
  ['connector suffix',       'y *Sent using* <@U0AVDBNH1K4>', [usr('y'), bookSummary],
   { confirmed: true }],
  ['past date',              'book studio 3 on 2027-07-01 2-5pm', [],
   { pastDateNotice: /ALREADY PASSED/ }],
  ['future date',            'book studio 3 on 2027-12-01 2-5pm', [],
   { pastDateNotice: '' }],
  // The date carries across turns within one conversation, so this runs after a
  // dated scenario and is expected to still know which day is being discussed.
  ['plain question carries date','is that slot still open?', [],
   { confirmed: false, dateNotice: /THE DATE UNDER DISCUSSION IS/ }],
  // ...but a question about which rooms exist is not a question about a day.
  // "list all the rooms" inherited a 2-5pm window and answered with the free
  // rooms only, presented as the whole list.
  ['catalogue question drops the carry','list all the rooms', [],
   { dateNotice: '' }],
  ['capability question drops the carry','what rooms can do 5.1?', [],
   { dateNotice: '' }],
  // "which rooms are free" is still an availability question and keeps it.
  ['an availability question keeps the carry','which rooms are free?', [],
   { dateNotice: /THE DATE UNDER DISCUSSION IS/ }],
  ['reset clears and says so','reset', [],
   { resetNotice: /ALREADY BEEN CLEARED|JUST BEEN CLEARED/, epoch: '1788077500.1' }],
  ['reset through connector', 'reset *Sent using* <@U0AVDBNH1K4>', [],
   { resetNotice: /JUST BEEN CLEARED/, epoch: '1788077500.1' }],
  // Mon-Wed is the one case where "next X" and "nearest upcoming X" diverge: with
  // today = Mon 6 Sep 2027, "this Thursday" (Sep 9) is still ahead, so "next
  // Thursday" is the FOLLOWING week (Sep 16) - Tara's rule, kept 2026-09-21. Locks
  // that the resolver does not collapse to nearest-upcoming. The 5th tuple element
  // overrides "today" for this case. See docs/design/date-resolution.md.
  ['next on a Monday is the following week', 'book studio 7 next thursday', [],
   { dateNotice: /Thursday, 16 September 2027/ }, Date.UTC(2026, 8, 6, 8, 20, 0)],
];

let failed = 0;
for (const [label, text, hist, want, nowUTC] of cases) {
  Date.now = () => (nowUTC != null ? nowUTC : DEFAULT_NOW);
  let r;
  try { r = run(text, hist); }
  catch (e) { console.log('THREW  ' + label + ' :: ' + e.message); failed++; continue; }
  const bad = [];
  for (const k of Object.keys(want)) {
    // A field that does not exist yet and a field that is empty are the same
    // thing to a caller, so normalise - otherwise running this against an older
    // workflow reports absent fields as wrong values.
    const got = r[k] === undefined || r[k] === null ? '' : r[k];
    const exp = want[k];
    const ok = exp instanceof RegExp ? exp.test(String(got)) : got === exp;
    if (!ok) bad.push(k + '=' + JSON.stringify(String(got || '').slice(0, 60)));
  }
  if (bad.length) { console.log('FAIL   ' + label + ' :: ' + bad.join('  ')); failed++; }
  else console.log('ok     ' + label);
}
console.log(failed ? '\n' + failed + ' failing' : '\nall ' + cases.length + ' scenarios pass');
process.exit(failed ? 1 : 0);
JS

node "$tmp/run.js" "$tmp/gate.js"
