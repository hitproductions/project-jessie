#!/usr/bin/env python3
"""Offline check for a hand import (route 1, from 29 Sep 2026: nobody's scripts connect to n8n any more).

  ./scripts/check-import before <downloaded.json> <build it should match>
      Before importing: is the live workflow (downloaded from n8n: workflow ⋯ → Download) still the build it
      replaced? If not, someone edited it in the browser or imported something else - rebuild on top of the
      download, do not import over it.
  ./scripts/check-import after <downloaded.json> <build that was imported>
      After importing and publishing: is what n8n stored the build? (stored == built)

Compares every node's parameters and settings (deactivated, type and version, credentials, on-error, execute-once,
always-output), the node list, the connections and the title. Reads files only; never contacts n8n.
30 Sep: a v199 import was stored with all 69 nodes deactivated and this still said MATCHES - it compared parameters only.
Exit 0 = matches, 1 = differs, 2 = usage.
"""
import json, re, sys

def load(p):
    try: return json.load(open(p))
    except Exception as e: sys.exit(f"cannot read {p}: {e}")

# n8n leaves a parameter out of the saved workflow when it has its default value; a build may state it. These count
# as equal (found 29 Sep: a Code node's mode "runOnceForAllItems" in the build, absent in the download).
# 6 Oct: Execute Workflow's source "database" (Book Series' Create Each), and the Data Table node's matchType "anyCondition"
# (main v226 Read Prepared - downloads keep "allConditions", so "anyCondition" is the default n8n leaves out).
DEFAULTS = {"n8n-nodes-base.code": {"mode": "runOnceForAllItems"},
            "n8n-nodes-base.executeWorkflow": {"source": "database"},
            "n8n-nodes-base.dataTable": {"matchType": "anyCondition"}}
def params(n):
    p = dict(n.get("parameters", {}))
    for k, v in DEFAULTS.get(n.get("type"), {}).items():
        if p.get(k) == v: p.pop(k)
    return json.dumps(p, sort_keys=True)
FLAGS = ("disabled", "type", "typeVersion", "credentials", "onError", "executeOnce", "alwaysOutputData", "retryOnFail")
def flags(n): return json.dumps({k: n.get(k) for k in FLAGS if n.get(k) not in (None, False)}, sort_keys=True)
def nodes(w): return {n.get("name"): params(n) + flags(n) for n in w.get("nodes", [])}
def off(w): return sorted(n.get("name") for n in w.get("nodes", []) if n.get("disabled"))
def stable(t): return re.sub(r"\s+[—-]\s+v\d+\b.*$", "", str(t or "")).strip()

if len(sys.argv) != 4 or sys.argv[1] not in ("before", "after"):
    print(__doc__.strip()); sys.exit(2)
mode, got_p, want_p = sys.argv[1:]
got, want = load(got_p), load(want_p)
A, B = nodes(got), nodes(want)
only_got = sorted(set(A) - set(B)); only_want = sorted(set(B) - set(A))
changed = sorted(k for k in set(A) & set(B) if A[k] != B[k])
conn_same = json.dumps(got.get("connections", {}), sort_keys=True) == json.dumps(want.get("connections", {}), sort_keys=True)
problems = []
if stable(got.get("name")) != stable(want.get("name")):
    problems.append(f'a different workflow: "{got.get("name")}" is not "{want.get("name")}"')
if mode == "after" and got.get("name") != want.get("name"):
    problems.append(f'title is "{got.get("name")}", expected "{want.get("name")}" (was the title set / the right file imported?)')
off_got, off_want = off(got), off(want)
if off_got != off_want:
    extra = [n for n in off_got if n not in off_want]
    if extra: problems.append(f"DEACTIVATED in the download but not in the build ({len(extra)} of {len(A)}): " + ", ".join(extra[:8]) + (" ..." if len(extra) > 8 else ""))
    back = [n for n in off_want if n not in off_got]
    if back: problems.append("deactivated in the build but active in the download: " + ", ".join(back))
    changed = [k for k in changed if k not in extra and k not in back]
if changed: problems.append("nodes that differ: " + ", ".join(changed))
if only_got: problems.append("nodes only in the download: " + ", ".join(only_got))
if only_want: problems.append("nodes only in the build: " + ", ".join(only_want))
if not conn_same: problems.append("the connections differ")

print(f"{mode}: {got_p}  vs  {want_p}")
print(f'  download: "{got.get("name")}"   ({len(A)} nodes)')
print(f'  build:    "{want.get("name")}"   ({len(B)} nodes)')
if not problems:
    print("  MATCHES" + (" - safe to import over it" if mode == "before" else " - stored == built"))
    sys.exit(0)
for p in problems: print("  DIFFERS - " + p)
print("  -> " + ("do NOT import: the live workflow changed since that build; rebuild on top of this download"
                 if mode == "before" else "the import did not land as built: check the file, re-import, and download again"))
sys.exit(1)
