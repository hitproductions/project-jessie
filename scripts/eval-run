#!/usr/bin/env node
// Plays the hallucination-eval scenarios through the eval twin and scores every reply (2026-09-27).
//
//   ./scripts/eval-run                         all scenarios x 5, rebuild the twin from live first
//   ./scripts/eval-run --repeat 2 --only ENG   a subset, fewer repeats
//   ./scripts/eval-run --no-build              reuse the twin as stored (still guard-checked)
//   ./scripts/eval-run --main workflows/x.json build the twin from a CANDIDATE main instead of live, to test a
//                                              prompt before importing it. Sub-workflows are still the live ones.
//
// One conversation at a time: Gate Context keeps each user's reset epoch in workflow static data, so two
// conversations for the same user in parallel would share it. Each conversation starts from a synthetic
// "reset" (exactly what a requester types), which gives it its own epoch and so its own memory and carried
// date. The twin is switched on only for the run and always switched off afterwards.
//
// Safety: a scenario turn that reads as a yes/confirmation is refused, so the confirmation gate can never
// pass; and if any reply ever shows a booking, cancellation or move tool succeeding, the run aborts at once.
// Results (raw + report) go to eval/results/, which is git-ignored.
const fs = require('fs'), path = require('path'), { execSync } = require('child_process');
const ROOT = path.resolve(__dirname, '..');
const EVAL = path.join(ROOT, 'eval');
const env = Object.fromEntries(fs.readFileSync(path.join(ROOT, '.env'), 'utf8').split('\n')
  .filter(l => /^\s*[A-Z0-9_]+=/.test(l)).map(l => { const i = l.indexOf('='); return [l.slice(0, i).trim(), l.slice(i + 1).trim().replace(/^['"]|['"]$/g, '')]; }));
const arg = (k, d) => { const i = process.argv.indexOf(k); return i === -1 ? d : process.argv[i + 1]; };
const REPEAT = Number(arg('--repeat', 5)), ONLY = arg('--only', ''), BUILD = !process.argv.includes('--no-build');
const MAIN_FILE = arg('--main', '');   // a candidate main to build from; guarded against that file, not live
const SCEN = JSON.parse(fs.readFileSync(arg('--scenarios', path.join(ROOT, 'docs/eval/scenarios.json')), 'utf8'));
const TWIN = fs.readFileSync(path.join(EVAL, '.twin-id'), 'utf8').trim();
const sh = c => execSync(c, { cwd: ROOT, stdio: ['ignore', 'pipe', 'inherit'] }).toString();

const YES = /^\s*(yes|y|yep|yeah|yup|sure|ok|okay|go|go ahead|confirm(ed)?|book it|do it|approve(d)?|proceed)\b[\s.!]*$/i;
const WRITE_OK = [['book session', /"CREATED"/], ['book series', /"BOOKED_SERIES"/], ['cancel booking', /"CANCELLED"/], ['move booking', /"MOVED"|"PARTIAL"/]];
const norm = s => String(s || '').toLowerCase().replace(/\s+/g, ' ').trim();
const toolName = st => String(((st || {}).action || {}).tool || '').replace(/[_\s]+/g, ' ').toLowerCase();

let lastTs = 0;
const nextTs = () => { lastTs = Math.max(Date.now() / 1000, lastTs + 1); return lastTs; };
const fmt = t => t.toFixed(6);

async function post(body) {
  const meta = JSON.parse(fs.readFileSync(path.join(EVAL, 'twin.meta.json'), 'utf8'));
  const ctl = new AbortController(); const timer = setTimeout(() => ctl.abort(), 150000);
  const t0 = Date.now();
  try {
    const r = await fetch(env.N8N_BASE_URL + '/webhook/' + meta.webhookPath, { method: 'POST', signal: ctl.signal,
      headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const text = await r.text(); let json; try { json = JSON.parse(text); } catch (e) { json = { ok: false, error: 'non-JSON reply: ' + text.slice(0, 200) }; }
    return { json, secs: (Date.now() - t0) / 1000, http: r.status };
  } catch (e) { return { json: { ok: false, error: String(e) }, secs: (Date.now() - t0) / 1000, http: 0 }; }
  finally { clearTimeout(timer); }
}

async function conversation(sc, rep) {
  const user = sc.user || SCEN.user;
  const reset = { type: 'message', user, text: 'reset', ts: fmt(nextTs()) };
  const history = [reset];            // newest first, as Slack returns it
  let last = null; const turns = [];
  for (const text of sc.turns) {
    const ts = fmt(nextTs());
    const res = await post({ user, text, ts, evalCase: sc.id + '#' + rep, history: history.slice() });
    turns.push({ text, secs: res.secs, http: res.http, ok: res.json.ok, reply: res.json.reply, error: res.json.error });
    for (const st of res.json.steps || []) for (const [tool, re] of WRITE_OK)
      if (toolName(st) === tool && re.test(String(st.observation || ''))) throw new Error('ABORT: ' + tool + ' reported success in ' + sc.id + ' - bookings must be impossible here');
    history.unshift({ type: 'message', user, text, ts });
    history.unshift({ type: 'message', bot_id: 'BEVAL', text: String(res.json.reply || ''), ts: fmt(nextTs()) });
    last = res.json;
  }
  return { last, turns };
}

// ---- scoring --------------------------------------------------------------------------------------------
const MONTHS = ['january','february','march','april','may','june','july','august','september','october','november','december'];
function summaryFields(reply) {
  const r = String(reply || '');
  const line = k => { const m = r.match(new RegExp('\\*?' + k + ':\\*?[ \\t]*([^\\n]+)', 'i')); return m ? m[1].replace(/\*/g, '').trim() : ''; };
  const tm = r.match(/^\s*\*?([^*\n]+?\s\/\s[^*\n]+?)\*?\s*$/m);
  return { isSummary: /Confirm to book\.\s*$/i.test(r), engineer: line('Engineer').replace(/\s*\(.*$/, '').trim(), client: line('Client'),
    date: line('Date'), bookedBy: line('Booked by'), title: tm ? tm[1].trim() : '' };
}
function expectedDate(dateNotice, phrase) {
  const re = /"([^"]+)"\s*=\s*\w+,\s*(\d{1,2})\s+(\w+)\s+(\d{4})/g; let m;
  while ((m = re.exec(String(dateNotice || '')))) if (norm(m[1]).includes(norm(phrase)) || norm(phrase).includes(norm(m[1])))
    return { d: +m[2], mo: MONTHS.indexOf(m[3].toLowerCase()), y: +m[4] };
  return null;
}
function parseSummaryDate(s) {
  const m = String(s).match(/(\w+)\s+(\d{1,2}),?\s+(\d{4})/); if (!m) return null;
  return { d: +m[2], mo: MONTHS.indexOf(m[1].toLowerCase()), y: +m[3] };
}
function score(sc, res) {
  const E = sc.expect || {}, R = res.last || {}, reply = String(R.reply || ''), F = summaryFields(reply), out = [];
  const add = (check, verdict, detail) => out.push({ check, verdict, detail: detail || '' });
  const staff = R.staff || [];
  const inStaff = n => staff.some(p => norm(p.name) === norm(n));
  if (!R.ok) { add('reply', 'fail', 'no reply: ' + String(R.error && (R.error.message || JSON.stringify(R.error)) || '').slice(0, 160)); return out; }
  if (/^(booked|cancelled|moved)/i.test(String(R.claimProbe || ''))) add('claim', 'fail', 'claimed ' + R.claimProbe);
  const wantsSummary = !E.mustAsk && !E.a1 && !E.engineerMustNotBe && !E.noSummaryExpected;
  if (wantsSummary && !F.isSummary) add('summary', 'fail', 'no summary: ' + reply.slice(0, 140).replace(/\n/g, ' '));
  if (E.engineer) {
    if (!F.isSummary) add('engineer', 'na');
    else if (!F.engineer) add('engineer', 'fail', 'summary has no Engineer line');
    else if (norm(F.engineer) === norm(E.engineer)) add('engineer', 'pass');
    else add('engineer', 'fail', (inStaff(F.engineer) ? 'wrong person: ' : 'INVENTED (not in Bookers): ') + F.engineer);
  }
  if (E.engineerMustNotBe) {
    const leaked = norm(reply).includes(norm(E.engineerMustNotBe)) && (F.isSummary || /\*?Engineer:\*?/i.test(reply));
    add('engineerUnknown', leaked ? 'fail' : 'pass', leaked ? 'wrote a non-staff engineer: ' + E.engineerMustNotBe : '');
  }
  // The calendar title is what gets booked; a summary without it asks the requester to approve something
  // they cannot see (found in the 2026-09-27 baseline: "*Project Title:* NOVA" and no title line at all).
  if (F.isSummary) add('titleShown', F.title ? 'pass' : 'fail', F.title ? '' : 'summary shows no calendar title');
  // v163: every booking summary should be the one Prepare Booking rendered (it carries a check code).
  if (F.isSummary && !/Confirm to book\.\s*$/.test('') ) add('prepared', /_check [0-9a-f]{8}_/.test(reply) ? 'pass' : 'fail', /_check [0-9a-f]{8}_/.test(reply) ? '' : 'the model wrote this summary itself');
  if (E.initials && F.isSummary && !F.title) add('initials', 'na', 'no title line');
  else if (E.initials && F.isSummary) {
    const seg = F.title.split(' / '); const ini = (seg[seg.length - 1] || '').split(' x ')[0].trim();
    add('initials', ini === E.initials ? 'pass' : 'fail', ini === E.initials ? '' : 'title "' + F.title + '"');
  }
  if (E.project && F.isSummary) {
    const projLine = (reply.match(/\*?Project(?: Title| Code)?:\*?[ \t]*([^\n]+)/i) || [])[1] || '';
    const hay = (F.title + ' ' + projLine).toUpperCase();
    add('project', hay.includes(E.project.toUpperCase()) ? 'pass' : 'fail', 'title "' + F.title + '", project "' + projLine.replace(/\*/g, '').trim() + '"');
  }
  if (E.client && F.isSummary) {
    const seg = F.title.split(' / '); const c = F.client || (seg.length === 3 ? seg[1] : '');
    add('client', E.client.some(x => norm(x) === norm(c)) ? 'pass' : 'fail', 'client "' + c + '"');
  }
  if (E.date && F.isSummary) {
    const want = expectedDate(R.gate && R.gate.dateNotice, E.date), got = parseSummaryDate(F.date);
    if (!want) add('date', 'na', 'Gate Context did not resolve "' + E.date + '"');
    else add('date', got && got.d === want.d && got.mo === want.mo && got.y === want.y ? 'pass' : 'fail', 'summary "' + F.date + '" vs ' + JSON.stringify(want));
  }
  // v167: the Time line, e.g. "2:00\\s*PM.*4:00\\s*PM"
  if (E.time && F.isSummary) {
    const tl = (reply.match(/\*?Time:\*?[ \t]*([^\n]+)/i) || [])[1] || '';
    add('time', new RegExp(E.time, 'i').test(tl) ? 'pass' : 'fail', 'Time "' + tl.trim() + '"');
  }
  if ('bookedFor' in E) {
    add('bookedForDetect', norm(R.bookedFor) === norm(E.bookedFor) ? 'pass' : 'fail', 'detected "' + (R.bookedFor || '') + '"');
    if (F.isSummary) {
      const shows = /\(for /i.test(F.bookedBy);
      if (E.bookedFor) add('bookedForSummary', norm(F.bookedBy).includes('(for ' + norm(E.bookedFor)) ? 'pass' : 'fail', 'Booked by "' + F.bookedBy + '"');
      else add('bookedForSummary', shows ? 'fail' : 'pass', shows ? 'Booked by "' + F.bookedBy + '"' : '');
    }
  }
  // v161: clients are optional. With none, the summary says "Client: None" and the title drops the segment.
  if (E.noClient) {
    if (!F.isSummary) add('noClient', 'fail', 'no summary: ' + reply.slice(0, 120).replace(/\n/g, ' '));
    else { const segs = F.title ? F.title.split(' / ').length : 0; const cl = norm(F.client);
      const ok = (!F.title || segs === 2) && (!cl || cl === 'none' || cl === 'n/a' || cl === '-');
      add('noClient', ok ? 'pass' : 'fail', 'title "' + F.title + '", client "' + F.client + '"'); }
  }
  // v161: client preferences are gone. Nothing may mention a preferred or usual room, or the old prompt example.
  { const leak = reply.match(/preferred room|usual room|\bDhang\b/i); add('noPreference', leak ? 'fail' : 'pass', leak ? '"' + leak[0] + '": ' + reply.slice(0, 120).replace(/\n/g, ' ') : ''); }
  if ('headsUp' in E && F.isSummary) add('headsUp', /Heads up:/.test(reply) === E.headsUp ? 'pass' : 'fail');
  if (E.mustAsk) add('mustAsk', !F.isSummary && /\?/.test(reply) ? 'pass' : 'fail', F.isSummary ? 'summarised with details never given' : '');
  if (E.a1) {
    let ra = null;
    for (const st of R.steps || []) if (toolName(st) === 'room availability') { try { const o = JSON.parse(st.observation); const x = Array.isArray(o) ? o[0] : o; if (x && x.free_rooms) ra = x; } catch (e) {} }
    if (!ra) add('a1', 'fail', 'no availability check this turn');
    else {
      const missing = ra.free_rooms.filter(n => !new RegExp('\\b' + n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b', 'i').test(reply));
      add('a1', missing.length ? 'fail' : 'pass', missing.length ? 'left out ' + missing.length + '/' + ra.free_rooms.length + ': ' + missing.join(', ') : '');
    }
  }
  // ---- QA-sheet checks (2026-09-27): each scored against the data this turn's tools returned ------------
  const obsOf = name => { const out2 = []; for (const st of R.steps || []) if (toolName(st) === name) { try { const o = JSON.parse(st.observation); (Array.isArray(o) ? o : [o]).forEach(x => out2.push(x)); } catch (e) {} } return out2; };
  const named = n => new RegExp('\\b' + String(n).replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b', 'i').test(reply);
  const roomNames = String(R.roomNames || '').split(' · ').map(x => x.trim()).filter(Boolean);
  let ref = {}; try { ref = JSON.parse(R.referenceData || '{}'); } catch (e) {}
  const roomById = Object.fromEntries((ref.rooms || []).map(r => [r.id, r]));
  const roomLine = F.isSummary ? (reply.match(/\*?Room:\*?[ \t]*([^\n]+)/i) || [])[1] || '' : '';
  if (E.listAll) {
    const missing = roomNames.filter(n => !named(n));
    const invented = [...new Set((reply.match(/\b(Studio [A-Z0-9]{1,2}|M\d{1,2})\b/g) || []))].filter(n => !roomNames.some(r => norm(r) === norm(n)));
    add('listRooms', missing.length || invented.length ? 'fail' : 'pass', (missing.length ? 'missing ' + missing.join(', ') : '') + (invented.length ? ' invented ' + invented.join(', ') : ''));
  }
  if (E.vocalBooths) {
    const booths = (ref.rooms || []).filter(r => r.vocalBooth).map(r => r.name), missing = booths.filter(n => !named(n));
    add('vocalBooths', missing.length ? 'fail' : 'pass', missing.length ? 'left out ' + missing.join(', ') + ' of ' + booths.join(', ') : '');
  }
  if (E.fivePointOne) {
    const recs = obsOf('rooms and studios').map(x => x.fields || x).filter(f => f['Room Name']);
    if (!recs.length) add('fivePointOne', 'fail', 'answered without reading Rooms and Studios');
    else {
      const has = f => /5\.1/.test(JSON.stringify(f['Recording Format'] || ''));
      const truth = recs.filter(has).map(f => f['Room Name'].trim());
      const trap = recs.filter(f => !has(f) && /5\.1/.test(JSON.stringify(f['Room Type'] || ''))).map(f => f['Room Name'].trim());
      const missing = truth.filter(n => !named(n)), wrong = trap.filter(n => named(n));
      add('fivePointOne', missing.length || wrong.length ? 'fail' : 'pass', (missing.length ? 'missing ' + missing.join(', ') : '') + (wrong.length ? ' named from Room Type (stereo only): ' + wrong.join(', ') : ''));
    }
  }
  if (E.mentions) { const ok = E.mentions.every(rx => new RegExp(rx, 'i').test(reply)); add('mentions', ok ? 'pass' : 'fail', ok ? '' : 'expected /' + E.mentions.join('/, /') + '/: ' + reply.slice(0, 140).replace(/\n/g, ' ')); }
  if (E.boothIncluded) {
    if (!F.isSummary) add('boothIncluded', 'na');
    else { const inc = (ref.rooms || []).some(r => (r.booth || r.vocalBooth) && named(r.name) && roomLine.toLowerCase().includes(r.name.toLowerCase()));
      add('boothIncluded', inc ? 'pass' : 'fail', 'Room "' + roomLine + '"'); }
  }
  if (E.priorityFor) {
    if (!F.isSummary) add('priorityRoom', 'na');
    else { const t = (ref.types || []).find(x => norm(x.type) === norm(E.priorityFor)); const pri = t ? t.priority.map(id => (roomById[id] || {}).name).filter(Boolean) : [];
      const ok = pri.some(n => roomLine.toLowerCase().includes(n.toLowerCase())); add('priorityRoom', ok ? 'pass' : 'fail', 'Room "' + roomLine + '" vs priority ' + pri.join(', ')); }
  }
  if (E.typicalFor && F.isSummary) {
    const t = obsOf('session types').map(x => x.fields || x).find(f => norm(f['Session Type'] || f['Name'] || f['Type']) === norm(E.typicalFor));
    const tm = reply.match(/(\d{1,2})(?::(\d{2}))?\s*(AM|PM)\s*[-–—]\s*(\d{1,2})(?::(\d{2}))?\s*(AM|PM)/i);
    const to24 = (h, ap) => (/pm/i.test(ap) ? (+h % 12) + 12 : (+h % 12));
    const mins = tm ? (to24(tm[4], tm[6]) * 60 + (+tm[5] || 0)) - (to24(tm[1], tm[3]) * 60 + (+tm[2] || 0)) : null;
    if (t && t['Typical Duration']) add('typicalDuration', mins === +t['Typical Duration'] ? 'pass' : 'fail', mins + ' min vs Typical Duration ' + t['Typical Duration']);
    else add('typicalDuration', 'na', 'Session Types not read this turn; length ' + mins + ' min');
  }
  if (E.room) {
    const ok = F.isSummary ? E.room.some(r => roomLine.toLowerCase().includes(r.toLowerCase())) : (E.roomOrAsk && /\?/.test(reply));
    add('room', ok ? 'pass' : 'fail', F.isSummary ? 'Room "' + roomLine + '"' : 'no summary: ' + reply.slice(0, 100).replace(/\n/g, ' '));
  }
  if (E.refusesPast) add('refusesPast', !F.isSummary && /(past|passed|already happened|gone by)/i.test(reply) ? 'pass' : 'fail', reply.slice(0, 120).replace(/\n/g, ' '));
  if (E.notFound) add('notFound', !/^(cancell?ed)/i.test(String(R.claimProbe || '')) && /(could ?n.?t find|can.?t find|cannot find|no booking|not find|don.?t see|not seeing|no .*booking|nothing booked)/i.test(reply) ? 'pass' : 'fail', reply.slice(0, 120).replace(/\n/g, ' '));
  if (E.seriesWeekday) {
    // The dates come from Expand Series' own answer when it ran (2026-09-28: the reply writes them as
    // "October 5, 12, 19, 26", which the old reply parser read as none). The reply parse is the fallback.
    const exp = obsOf('expand series').flatMap(x => [].concat(x.dates || x.occurrences || x.sessions || []))
      .map(d => String((d && (d.date || d.start || d.start_iso)) || d).slice(0, 10)).filter(d => /^\d{4}-\d{2}-\d{2}$/.test(d));
    const ds = [...reply.matchAll(/(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{1,2}),?\s+(\d{4})/g)].map(m => new Date(Date.UTC(+m[3], MONTHS.indexOf(m[1].toLowerCase()), +m[2])));
    const days = exp.length ? [...new Set(exp)] : [...new Set(ds.map(d => d.toISOString().slice(0, 10)))];
    const wd = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'].indexOf(E.seriesWeekday.toLowerCase());
    const wrong = days.filter(d => new Date(d + 'T00:00:00Z').getUTCDay() !== wd);
    add('series', days.length >= (E.seriesMin || 4) && !wrong.length ? 'pass' : 'fail', days.length + ' dates' + (wrong.length ? ', not ' + E.seriesWeekday + ': ' + wrong.join(', ') : ''));
  }
  // v164: the prompt's placeholders (<colleague>, <name>, <Client A>, [Full Name]) must never reach a reply.
  { const ph = reply.match(/<(?:you|them|name|colleague|client|another client|client a|client b|room|free room|session type|title|owner|meeting title|event|project|ei)>|\[(?:Full Name|Role)\]/i); add('noPlaceholder', ph ? 'fail' : 'pass', ph ? 'leaked ' + ph[0] : ''); }
  // decision (d): "studios" leaves the conference rooms and the lobby out of a free list.
  if (E.noCommon) { const hit = reply.match(/\b(Likha|Katha|Salin|Lobby)\b/); add('noCommon', hit ? 'fail' : 'pass', hit ? 'named ' + hit[0] : ''); }
  if (E.lookupOnly) {
    const titles = [...obsOf('find booking'), ...obsOf('list events')].flatMap(x => (x.bookings || x.events || (x.summary ? [x] : [])).map(b => b.title || b.summary)).filter(Boolean);
    const shown = [...reply.matchAll(/([A-Z0-9][A-Z0-9 &'-]{1,}\s\/\s[^\n*]+?)(?=\*|\n|$| on | from | at )/g)].map(m => m[1].trim());
    const invented = shown.filter(t => !titles.some(x => norm(x).startsWith(norm(t).slice(0, 12))));
    add('lookup', invented.length ? 'fail' : 'pass', invented.length ? 'not in the tool results: ' + invented.join(' | ') : titles.length + ' bookings from tools, ' + shown.length + ' shown');
  }
  if (E.roomStatusFor) {
    const ra = obsOf('room availability').map(x => x.asked).filter(a => a && norm(a.room) === norm(E.roomStatusFor)).pop();
    if (!ra) add('roomStatus', 'fail', 'no availability check for ' + E.roomStatusFor);
    else { const saysFree = /\b(is free|is available|available|open)\b/i.test(reply) && !/\b(not free|not available|taken|booked|busy)\b/i.test(reply);
      const free = /^FREE/.test(ra.status); add('roomStatus', saysFree === free ? 'pass' : 'fail', 'tool said ' + ra.status + '; reply ' + reply.slice(0, 100).replace(/\n/g, ' ')); }
  }
  if (E.onlyTimeChanges && res.turns.length >= 2) {
    const A = summaryFields(res.turns[0].reply), B = F; const same = k => norm(A[k]) === norm(B[k]);
    const t0 = (String(res.turns[0].reply).match(/\*?Time:\*?[ \t]*([^\n]+)/i) || [])[1] || '', t1 = (reply.match(/\*?Time:\*?[ \t]*([^\n]+)/i) || [])[1] || '';
    const r0 = (String(res.turns[0].reply).match(/\*?Room:\*?[ \t]*([^\n]+)/i) || [])[1] || '';
    const ok = A.isSummary && B.isSummary && same('engineer') && same('date') && norm(r0) === norm(roomLine) && norm(t0) !== norm(t1) && new RegExp(E.onlyTimeChanges, 'i').test(t1);
    add('onlyTimeChanges', ok ? 'pass' : 'fail', 'before "' + t0 + '" / ' + A.engineer + ' / ' + r0 + ' -> after "' + t1 + '" / ' + B.engineer + ' / ' + roomLine);
  }
  if (E.room2 && F.isSummary) add('secondRequest', E.room2.some(r => roomLine.toLowerCase().includes(r.toLowerCase())) && F.title.toUpperCase().includes(E.project2) ? 'pass' : 'fail', 'Room "' + roomLine + '", title "' + F.title + '"');
  if (E.repliesNormally) add('repliesNormally', R.ok && reply.length > 10 ? 'pass' : 'fail');
  return out;
}

// ---- main -----------------------------------------------------------------------------------------------
(async () => {
  const list = SCEN.scenarios.filter(s => !ONLY || ONLY.split(',').some(p => s.id.startsWith(p.trim())));
  for (const s of list) for (const t of s.turns) if (YES.test(t)) { console.error('REFUSED: scenario ' + s.id + ' has a confirmation turn ("' + t + '")'); process.exit(3); }
  if (MAIN_FILE && !BUILD) { console.error('--main needs a build; drop --no-build'); process.exit(64); }
  const SRC = MAIN_FILE ? path.resolve(MAIN_FILE) : path.join(EVAL, 'live-main.json');
  if (BUILD) { process.stdout.write(sh(MAIN_FILE ? `./scripts/eval-twin build "${SRC}"` : './scripts/eval-twin build')); sh(`./scripts/n8n-write put ${TWIN} eval/twin.json`); }
  if (MAIN_FILE) console.log('CANDIDATE main: ' + MAIN_FILE + ' (sub-workflows are live)');
  sh(`./scripts/n8n pull ${TWIN} /tmp/eval-twin-stored.json`);
  sh(`./scripts/eval-twin guard /tmp/eval-twin-stored.json "${SRC}"`);
  console.log('twin stored + guard clean. ' + list.length + ' scenarios x ' + REPEAT + ' = ' + list.length * REPEAT + ' conversations\n');
  sh(`./scripts/n8n-write activate ${TWIN}`);
  const results = []; let aborted = '';
  try {
    for (const s of list) for (let r = 1; r <= REPEAT; r++) {
      const res = await conversation(s, r);
      const checks = score(s, res);
      const keep = res.last ? Object.assign({}, res.last, { staff: undefined, referenceData: undefined }) : null;
      results.push({ id: s.id, class: s.class, rep: r, turns: res.turns, checks, reply: res.last && res.last.reply, bookedFor: res.last && res.last.bookedFor, last: keep });
      const f = checks.filter(c => c.verdict === 'fail');
      console.log(`${s.id}#${r}  ${res.turns.map(t => t.secs.toFixed(1) + 's').join(' + ')}  ${f.length ? 'FAIL ' + f.map(c => c.check + (c.detail ? ' (' + c.detail + ')' : '')).join('; ') : 'ok'}`);
    }
  } catch (e) { aborted = String(e.message || e); console.error('\n' + aborted); }
  finally { sh(`./scripts/n8n-write deactivate ${TWIN}`); console.log('\ntwin switched off'); }

  // ---- report
  const by = {}; const times = [];
  for (const r of results) { for (const t of r.turns) times.push(t.secs); for (const c of r.checks) { const k = c.check; by[k] = by[k] || { pass: 0, fail: 0, na: 0, fails: [] }; by[k][c.verdict]++; if (c.verdict === 'fail') by[k].fails.push(r.id + '#' + r.rep + ': ' + c.detail); } }
  times.sort((a, b) => a - b); const q = p => times.length ? times[Math.min(times.length - 1, Math.floor(p * times.length))].toFixed(1) : '-';
  const stamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
  const L = ['# Eval run ' + stamp, '', 'Live main ' + (JSON.parse(fs.readFileSync(path.join(EVAL, 'twin.meta.json'), 'utf8')).liveUpdatedAt || '?') + ' · ' + results.length + ' conversations · turn time median ' + q(.5) + 's, p90 ' + q(.9) + 's' + (aborted ? '\n\n**ABORTED:** ' + aborted : ''), '',
    '| check | pass | fail | rate of failure |', '|---|---|---|---|'];
  for (const [k, v] of Object.entries(by)) { const n = v.pass + v.fail; L.push(`| ${k} | ${v.pass} | ${v.fail} | ${n ? Math.round(100 * v.fail / n) + '%' : '-'} |`); }
  // Consistency (QA D1/D2): the same request should land on the same room, time and engineer every repeat.
  const byId = {}; for (const r of results) { const f = summaryFields(r.reply); if (!f.isSummary) continue;
    const room = (String(r.reply).match(/\*?Room:\*?[ \t]*([^\n]+)/i) || [])[1] || '', time = (String(r.reply).match(/\*?Time:\*?[ \t]*([^\n]+)/i) || [])[1] || '';
    (byId[r.id] = byId[r.id] || new Set()).add([norm(room), norm(time), norm(f.engineer), norm(f.date)].join(' | ')); }
  const incon = Object.entries(byId).filter(([, v]) => v.size > 1);
  L.push('', '## Consistency across repeats', '', Object.keys(byId).length + ' scenarios produced summaries; ' + incon.length + ' gave different room / time / engineer / date between repeats.');
  incon.forEach(([id, v]) => L.push('- ' + id + ': ' + [...v].join('  ||  ')));
  L.push('', '## Failures');
  for (const [k, v] of Object.entries(by)) if (v.fails.length) { L.push('', '### ' + k); v.fails.forEach(f => L.push('- ' + f)); }
  fs.mkdirSync(path.join(EVAL, 'results'), { recursive: true });
  fs.writeFileSync(path.join(EVAL, 'results', 'run-' + stamp + '.json'), JSON.stringify({ stamp, results }, null, 1));
  fs.writeFileSync(path.join(EVAL, 'results', 'run-' + stamp + '.md'), L.join('\n') + '\n');
  console.log('\n' + L.join('\n') + '\n\nsaved eval/results/run-' + stamp + '.{md,json}');
  process.exit(aborted ? 4 : 0);
})();
