#!/usr/bin/env bash
# Thin wrapper over the n8n public API. Reads credentials from ../.env
#
#   ./scripts/n8n list                     list workflows (id, name, active)
#   ./scripts/n8n get <id>                 print one workflow as JSON
#   ./scripts/n8n pull <id> <file>         save a workflow to a file
#   ./scripts/n8n execs [id] [limit]       recent executions, newest first
#   ./scripts/n8n exec <execId>            one execution in full, with data
#   ./scripts/n8n exec <execId> --errors   just the nodes that errored
#
# This wrapper reads. Workflows are imported by hand through the n8n browser UI:
# the API write path reported success and changed nothing (PENDING 12).
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
[ -f "$here/.env" ] || { echo "No $here/.env — copy .env.example and add your key." >&2; exit 1; }
set -a; . "$here/.env"; set +a
: "${N8N_BASE_URL:?N8N_BASE_URL missing from .env}"
: "${N8N_API_KEY:?N8N_API_KEY missing from .env}"

api() { curl -sS -H "X-N8N-API-KEY: $N8N_API_KEY" -H 'Accept: application/json' "$@"; }
MAIN_ID="uVVYVB2M7kxpLleI"   # Project Jessie
SUB_ID="EUG3sGXkfsJSYIMz"    # Jessie — Book Session

cmd="${1:-help}"; shift || true
case "$cmd" in
  list)
    api "$N8N_BASE_URL/api/v1/workflows?limit=100" | python3 -c '
import json,sys
for w in json.load(sys.stdin).get("data", []):
    state = "active" if w.get("active") else "      "
    print("%-20s %s  %s" % (w["id"], state, w["name"]))'
    ;;
  get)
    api "$N8N_BASE_URL/api/v1/workflows/${1:?workflow id}" | python3 -m json.tool
    ;;
  pull)
    id="${1:?workflow id}"; out="${2:?output file}"
    # Drops staticData.global.refCache: main v158's Ref Store caches the rooms, session
    # types and staff tables there. It churns every 10 minutes and is not config.
    api "$N8N_BASE_URL/api/v1/workflows/$id" | python3 -c 'import json,sys
d=json.load(sys.stdin); ((d.get("staticData") or {}).get("global") or {}).pop("refCache",None)
json.dump(d,sys.stdout,indent=4); print()' > "$out"
    echo "saved $out"
    ;;
  execs)
    id="${1:-$MAIN_ID}"; limit="${2:-20}"
    api "$N8N_BASE_URL/api/v1/executions?workflowId=$id&limit=$limit" | python3 -c '
import json,sys
for e in json.load(sys.stdin).get("data", []):
    print("%8s  %-10s %-26s %s" % (e["id"], e.get("status","?"), e.get("startedAt",""), e.get("mode","")))'
    ;;
  exec)
    eid="${1:?execution id}"; mode="${2:-}"
    raw="$(api "$N8N_BASE_URL/api/v1/executions/$eid?includeData=true")"
    if [ "$mode" = "--errors" ]; then
      printf '%s' "$raw" | python3 -c '
import json,sys
e = json.load(sys.stdin)
print("status:", e.get("status"), "| started:", e.get("startedAt"))
run = (e.get("data") or {}).get("resultData") or {}
we = run.get("error") or {}
if we:
    print("workflow error:", we.get("message", "")[:300], "| from:", (we.get("node") or {}).get("name", ""))
for name, runs in (run.get("runData") or {}).items():
    for r in runs:
        branches = (r.get("data") or {}).get("main") or []
        counts = "/".join(str(len(b or [])) for b in branches) or "0"
        print(name + ": " + counts + " item(s)" + (" ERROR" if r.get("error") else ""))
        err = r.get("error") or {}
        if err:
            node = (err.get("node") or {}).get("name", "")
            print("    message:", err.get("message", "")[:300])
            if err.get("description"): print("    hint   :", str(err["description"])[:300])
            if node: print("    from   :", node)
        for b in branches:
            for it in (b or []):
                j = it.get("json") if isinstance(it, dict) else None
                if isinstance(j, dict) and "output" in j:
                    print("    output :", str(j["output"])[:200].replace("\n", " "))'
    else
      printf '%s' "$raw" | python3 -m json.tool
    fi
    ;;
  ids) echo "main $MAIN_ID"; echo "sub  $SUB_ID" ;;
  *) sed -n '2,17p' "$0" ;;
esac
