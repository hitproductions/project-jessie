#!/usr/bin/env bash
# Snapshot every live n8n workflow into workflows/live/.
#
#   ./scripts/backup-live         # uses .env for the key and base url
#
# Also run nightly on GitHub's servers by .github/workflows/nightly-backup.yml,
# which sets N8N_API_KEY and N8N_BASE_URL from repo secrets instead of .env.
#
# This does not commit - the caller decides. Run by hand any time you want a
# fresh copy of what n8n is actually running.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here"
if [ -z "${N8N_API_KEY:-}" ] && [ -f .env ]; then set -a; . ./.env; set +a; fi
: "${N8N_API_KEY:?set N8N_API_KEY (in .env, or the environment)}"
: "${N8N_BASE_URL:?set N8N_BASE_URL}"

python3 - <<'PY'
import json, os, re, subprocess, time
base, key = os.environ["N8N_BASE_URL"], os.environ["N8N_API_KEY"]

class Unreachable(Exception): pass

def api(path):
    # n8n has gone unreachable to the outside world for hours at a time (PENDING 15).
    # A backup that runs during one of those windows should skip cleanly, not crash
    # or cry wolf - the outage is not a backup bug. Retry a few times first, in case
    # it is only a blip.
    last = ""
    for attempt in range(4):
        out = subprocess.run(["curl","-sS","--max-time","30","-H","X-N8N-API-KEY: "+key, base+path],
                             capture_output=True, text=True)
        if out.returncode == 0 and out.stdout.strip():
            try:
                return json.loads(out.stdout)
            except ValueError:
                last = "non-JSON response (first 120 chars): " + out.stdout[:120]
        else:
            last = out.stderr.strip()[:200] or "empty response"
        time.sleep(5 * (attempt + 1))
    # Could not get JSON. Capture the status + Cloudflare headers so an outage
    # records *which* challenge is being served, not just that one is (docs/outages/OUTAGES.md).
    h = subprocess.run(["curl","-sS","-D","-","-o","/dev/null","--max-time","30",
                        "-H","X-N8N-API-KEY: "+key, base+path], capture_output=True, text=True).stdout
    keep = [l for l in h.splitlines() if l[:5]=="HTTP/" or l.split(":")[0].lower() in
            ("server","cf-ray","cf-mitigated","cf-cache-status","retry-after")]
    raise Unreachable(last + " || " + " | ".join(keep) if keep else last)

os.makedirs("workflows/live", exist_ok=True)
slug = lambda s: re.sub(r'[^a-zA-Z0-9]+', '-', s).strip('-').lower()[:60]
try:
    data = api("/api/v1/workflows?limit=200").get("data", [])
except Unreachable as e:
    import sys
    # This used to exit 0 so an outage would not cry wolf. That was a mistake: from
    # 2026-09-06 to -13 the job reported success every run while backing up nothing,
    # because Cloudflare was challenging GitHub's runners (403, cf-mitigated:
    # challenge). Eight days of no backup, invisible. A backup that cannot back up is
    # a failure, even when the reason is not our fault - fail loudly.
    print("FAILED: n8n was unreachable after retries - NOTHING WAS BACKED UP.")
    print("  last error: %s" % e)
    print("  A 403 with 'cf-mitigated: challenge' means Cloudflare is challenging this")
    print("  runner's IP. Fix: allowlist GitHub's IP ranges in Cloudflare, or run")
    print("  scripts/backup-live from the VM instead, where it is not challenged.")
    sys.exit(1)
index = []
for w in data:
    full = api("/api/v1/workflows/" + w["id"])
    fn = "%s__%s.json" % (slug(w.get("name","untitled")), w["id"])
    with open("workflows/live/"+fn, "w") as f:
        json.dump(full, f, indent=2, ensure_ascii=False, sort_keys=True)
    index.append("%-42s %-8s %s" % (w.get("name"),
                 "active" if w.get("active") else "inactive", fn))
# The snapshot must contain everything this project cannot afford to lose. A key
# that has lost access to a project does not error - it returns a SHORTER list. So
# a short list means "check the key", never "these were deleted".
EXPECTED = {
 "uVVYVB2M7kxpLleI":"Project Jessie v2","EUG3sGXkfsJSYIMz":"Jessie — Book Session",
 "bAyDw7udhmY0NL38":"Jessie — Cancel Booking","t7lwR2km4tfN8DbM":"Jessie — Move Booking",
 "yzirq12O227VTFp8":"Jessie — Find Booking","e7tBQB458nstrqei":"Jessie — Room Availability",
 "K2tPBykMwKcQGMub":"Jessie — Prune Executions"}
seen    = set(w["id"] for w in data)
missing = {k: v for k, v in EXPECTED.items() if k not in seen}
if missing:
    import sys
    print("FAILED: the API key cannot see %d workflow(s) this backup must include." % len(missing))
    for k, v in missing.items():
        print("    missing: %s  %s" % (k, v))
    print("  Saw %d workflow(s). Existing snapshots were left untouched." % len(data))
    print("  This is almost always the API key, not a deletion: n8n returns a shorter")
    print("  list - not an error - when the key's account cannot see a project. Use a")
    print("  key created on the account that owns these workflows.")
    sys.exit(1)

# Never delete a snapshot automatically. This loop used to mirror the instance by
# removing anything n8n no longer listed. With a key that could see 5 of 12
# workflows - exactly the state on 2026-09-17 - it would have deleted all seven
# Jessie snapshots, which are the rollback artifact, and reported success.
keep  = set("%s__%s.json" % (slug(w.get("name","untitled")), w["id"]) for w in data)
stale = sorted(f for f in os.listdir("workflows/live")
               if f.endswith(".json") and f not in keep)

with open("workflows/live/INDEX.txt", "w") as f:
    f.write("Live n8n workflows, snapshot. Backed up nightly by GitHub Actions.\n\n")
    f.write("\n".join(sorted(index)) + "\n")
print("backed up %d workflows to workflows/live/" % len(data))
if stale:
    print("\n  %d snapshot(s) here are not in n8n's list:" % len(stale))
    for f in stale: print("      %s" % f)
    print("  Left in place on purpose. Confirm they were really deleted in n8n - not")
    print("  merely invisible to this key - before removing any by hand.")
PY
