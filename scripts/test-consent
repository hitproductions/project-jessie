#!/usr/bin/env node
// Offline checks for the consent engine's Open Consent Request -> Build Request node: the response
// window (deadline) per kind, and the recipient routing. test-nodes does not load the consent
// workflows, so this covers them. Added 2026-09-25 when the M-booth deadline tiers were ported.
//
//   ./scripts/test-consent                 # newest workflows/open-consent-request-vNN.json
//   ./scripts/test-consent <file.json>     # a candidate
//   ./scripts/test-consent --live          # what n8n has stored
const fs = require('fs'), path = require('path'), { execSync } = require('child_process');
const ROOT = path.resolve(__dirname, '..');
const arg = process.argv[2];
let file = arg;
if (arg === '--live') {
  file = '/tmp/open-consent-live-for-test.json';
  execSync(`"${ROOT}/scripts/n8n" pull nEHnCMMXS0am59Zy ${file}`, { stdio: ['ignore', 'ignore', 'inherit'] });
} else if (!arg) {
  const v = fs.readdirSync(path.join(ROOT, 'workflows')).map(f => (f.match(/^open-consent-request-v(\d+)\.json$/) || [])[1]).filter(Boolean).map(Number);
  file = path.join(ROOT, 'workflows', 'open-consent-request-v' + Math.max(...v) + '.json');
}
console.log('testing ' + file + '\n');
const wf = JSON.parse(fs.readFileSync(file, 'utf8'));
const code = wf.nodes.find(n => n.name === 'Build Request').parameters.jsCode;

let pass = 0, fail = 0;
const check = (label, ok, detail) => { if (ok) { pass++; console.log('  ok    ' + label); } else { fail++; console.log('  FAIL  ' + label + (detail ? '  :: ' + detail : '')); } };

// Run the whole node with a fixed clock: `new Date()` with no argument returns NOW.
const run = (nowISO, input) => {
  const Real = Date;
  class FixedDate extends Real { constructor(...a) { if (a.length) super(...a); else super(nowISO); } static now() { return new Real(nowISO).getTime(); } }
  const $ = name => ({ first: () => ({ json: name === 'When Executed by Another Workflow' ? input : {} }), all: () => [] });   // all(): Read Cache / Read Requests (v12+)
  const j = new Function('$', 'Date', code)($, FixedDate)[0].json; return j.row || j;   // v12+: { dup, row }
};
const iso = s => new Date(s).toISOString();
const NOW = '2027-10-20T09:00:00+08:00';

console.log('M-booth deadline tiers (Howard, 2026-09-22)');
if (!/function mboothDeadline/.test(code)) {
  console.log('  skip  this build has no M-booth tiers (pre-v10)');
} else {
  const mb = (now, start) => run(now, { kind: 'MBOOTH', reqStart: start, requester: 'U08V3CKDGJF', approver: 'U08V3CKDGJF' }).Deadline;
  check('2+ days away -> now + 24h', mb(NOW, '2027-10-25T14:00:00+08:00') === iso('2027-10-21T09:00:00+08:00'));
  check('tomorrow -> 10:00 Manila on the booking day', mb(NOW, '2027-10-21T14:00:00+08:00') === iso('2027-10-21T10:00:00+08:00'));
  check('same day -> now + 3h', mb(NOW, '2027-10-20T15:00:00+08:00') === iso('2027-10-20T12:00:00+08:00'));
  check('same day capped at the session start', mb(NOW, '2027-10-20T10:00:00+08:00') === iso('2027-10-20T10:00:00+08:00'));
  check('tomorrow capped when 10:00 is after the start', mb(NOW, '2027-10-21T09:00:00+08:00') === iso('2027-10-21T09:00:00+08:00'));
  check('a start already past -> deadline is now', mb(NOW, '2027-10-20T08:00:00+08:00') === iso(NOW));
  check('crossing midnight counts as a calendar day', mb('2027-10-20T23:00:00+08:00', '2027-10-21T09:00:00+08:00') === iso('2027-10-21T09:00:00+08:00'));
  if (/function realYear/.test(code)) {
    // v13 (decided 29 Oct): an all-day request is settled before its day - tomorrow 6:00 PM the evening before, today 1 h
    const mbA = (now, start, end, pl) => run(now, Object.assign({ kind: 'MBOOTH', reqStart: start, reqEnd: end || '', requester: 'U08V3CKDGJF', approver: 'U08V3CKDGJF' }, pl ? { reqPayload: JSON.stringify(pl) } : {})).Deadline;
    check('v13: all day tomorrow (date only) -> 6:00 PM today', mbA(NOW, '2027-10-21') === iso('2027-10-20T18:00:00+08:00'));
    check('v13: all day tomorrow (12 AM - 12 AM) -> 6:00 PM today', mbA(NOW, '2027-10-21T00:00:00+08:00', '2027-10-22T00:00:00+08:00') === iso('2027-10-20T18:00:00+08:00'));
    check('v13: all day tomorrow, asked 5:30 PM -> 1 h (6:30 PM)', mbA('2027-10-20T17:30:00+08:00', '2027-10-21T00:00:00+08:00', '2027-10-22T00:00:00+08:00') === iso('2027-10-20T18:30:00+08:00'));
    check('v13: all day tomorrow, asked 11:30 PM -> never past midnight', mbA('2027-10-20T23:30:00+08:00', '2027-10-21T00:00:00+08:00', '2027-10-22T00:00:00+08:00') === iso('2027-10-21T00:00:00+08:00'));
    check('v13: all day TODAY -> 1 h (was: now, booked within minutes)', mbA(NOW, '2027-10-20T00:00:00+08:00', '2027-10-21T00:00:00+08:00') === iso('2027-10-20T10:00:00+08:00'));
    check('v13: all day today by the payload flag -> 1 h', mbA(NOW, '2027-10-20T00:00:00+08:00', '', { all_day: true }) === iso('2027-10-20T10:00:00+08:00'));
    check('v13: all day 3 days ahead -> 24 h', mbA(NOW, '2027-10-23T00:00:00+08:00', '2027-10-24T00:00:00+08:00') === iso('2027-10-21T09:00:00+08:00'));
    check('v13: all day the day after tomorrow, asked 2 AM -> 24 h, before its day', mbA('2027-10-20T02:00:00+08:00', '2027-10-22T00:00:00+08:00', '2027-10-23T00:00:00+08:00') === iso('2027-10-21T02:00:00+08:00'));
    check('v13: a timed booking from 12 AM to 3 AM is not all day', mbA(NOW, '2027-10-21T00:00:00+08:00', '2027-10-21T03:00:00+08:00') === iso('2027-10-21T00:00:00+08:00'));
    // v13: QA - the booking a year ahead is timed on its real-year date (YEAR_SHIFT 1)
    const QNOW = '2026-10-28T14:00:00+08:00', shift = /const YEAR_SHIFT = 1;/.test(code);
    check('v13 QA: the M booth "today" in the form (2027) all day -> 1 h, not "tomorrow"', !shift || mbA(QNOW, '2027-10-28T00:00:00+08:00', '2027-10-29T00:00:00+08:00') === iso('2026-10-28T15:00:00+08:00'));
    check('v13 QA: today 6-9 PM in the form -> 3 h', !shift || mbA(QNOW, '2027-10-28T18:00:00+08:00', '2027-10-28T21:00:00+08:00') === iso('2026-10-28T17:00:00+08:00'));
    check('v13 QA: a priority request today 4 PM in the form -> 3 PM (start - 1 h)', !shift || run(QNOW, { kind: 'PREEMPT', reqStart: '2027-10-28T16:00:00+08:00', requester: 'U08V3CKDGJF', approver: 'U08V3CKDGJF' }).Deadline === iso('2026-10-28T15:00:00+08:00'));
    check('v13 QA: a 2026 date (real year, typed) is not shifted', !shift || mbA(QNOW, '2026-10-30T14:00:00+08:00', '2026-10-30T16:00:00+08:00') === iso('2026-10-29T14:00:00+08:00'));
  } else check('an all-day booth tomorrow (date only) closes by its start', mb(NOW, '2027-10-21') === iso('2027-10-21T08:00:00+08:00'));
}

console.log('\nPriority (PREEMPT) keeps "earlier of now + 24h and start - 1h"');
const pe = (now, start) => run(now, { kind: 'PREEMPT', reqStart: start, requester: 'U08V3CKDGJF', approver: 'U08V3CKDGJF' }).Deadline;
check('tomorrow 2pm -> now + 24h (before start - 1h)', pe(NOW, '2027-10-21T14:00:00+08:00') === iso('2027-10-21T09:00:00+08:00'));
check('same day 3pm -> start - 1h', pe(NOW, '2027-10-20T15:00:00+08:00') === iso('2027-10-20T14:00:00+08:00'));
check('a kind left blank is treated as PREEMPT', run(NOW, { reqStart: '2027-10-20T15:00:00+08:00' }).Deadline === iso('2027-10-20T14:00:00+08:00'));

console.log('\nRow shape and routing are unchanged');
const r = run(NOW, { kind: 'MBOOTH', reqStart: '2027-10-25T14:00:00+08:00', requester: 'U08V3CKDGJF', approver: 'UREALHOLDER', room: 'M1' });
check('a PENDING row of the right kind', r.Status === 'PENDING' && r.Kind === 'MBOOTH' && r['Room/Booth'] === 'M1');
const redirecting = /const DEV_REDIRECT = '[^']+'/.test(code);
check(redirecting ? 'a non-ALLOW approver is redirected while DEV_REDIRECT is set' : 'DEV_REDIRECT is off: the real approver is kept',
  redirecting ? r.Approver === 'U08V3CKDGJF' : r.Approver === 'UREALHOLDER', 'Approver=' + r.Approver);

console.log('\n' + (fail ? fail + ' failing, ' + pass + ' passing' : 'all ' + pass + ' checks pass'));
process.exit(fail ? 1 : 0);
