// ── Notification recipients ──────────────────────────────────────────────────
// Build Recipients composes the DMs sent on an authorized change: the booker
// always, plus the assigned engineer (from Lookup Engineer) when distinct from
// the booker and the actor. DEV_REDIRECT routes the `to` to the dev inbox while
// building; the real name/id is named in the body. (Move's copy is tested; the
// Cancel copy differs only in the verb and has no room note.)
suite('Build Recipients — who gets a DM on an authorized change', ()=>{
  const s=src('Build Recipients');
  const run=(co,trig,eng)=>new Function('$',s)(name=>{
    if(name==='Resolve Booking') return {first:()=>({json:co})};
    if(name==='When Executed by Another Workflow') return {first:()=>({json:trig})};
    if(name==='Lookup Engineer') return {first:()=>({json:eng})};
    return {first:()=>({json:{}})};
  }).map(i=>i.json);
  const co={bookerRef:'U0TESTVENER',bookerName:'Vener Ariston',title:'X / Y / TL',roomNote:' to Studio 7'};
  const trig={requester_name:'Howard Luistro',requester:'U08V3CKDGJF',booking_date:'2027-10-15'};
  const engRow=id=>({fields:{'Slack User ID':id,'Name':'Tara Lim'}});

  let r=run(co,trig,{});
  check('nr','booker only when no engineer match',r.length===1&&/Vener Ariston \(U0TESTVENER\)/.test(r[0].text),JSON.stringify(r).slice(0,90));
  check('nr','booker DM is dev-redirected',r[0].to==='U08V3CKDGJF'&&/^\[DEV\] would notify/.test(r[0].text));
  check('nr','booker DM carries the room note',/was moved to Studio 7 by Howard Luistro/.test(r[0].text));

  r=run(co,trig,engRow('U026N6E1R'));   // engineer Tara IS on ALLOW
  check('nr','engineer added when distinct',r.length===2&&/you are assigned to/.test(r[1].text),JSON.stringify(r).slice(0,120));
  check('nr','an allowlisted engineer gets a real DM (honors ALLOW)',r[1].to==='U026N6E1R'&&!/\[DEV\]/.test(r[1].text));
  r=run(co,trig,engRow('U0TESTENG'));   // engineer NOT on ALLOW -> still redirected
  check('nr','a non-allowlisted engineer is still redirected',r.length===2&&r[1].to==='U08V3CKDGJF'&&/^\[DEV\] would notify/.test(r[1].text));

  r=run(co,trig,engRow('U0TESTVENER'));   // engineer IS the booker
  check('nr','no duplicate when engineer is the booker',r.length===1);
  r=run(co,trig,engRow('U08V3CKDGJF'));   // engineer IS the actor
  check('nr','no self-notify when engineer is the actor',r.length===1);

  // QA allowlist: an allowlisted recipient (a Sept-24 tester) gets a real DM, no [DEV].
  r=run({...co,bookerRef:'U098UFMKQHZ',bookerName:'Trish'},trig,{});
  check('nr','an allowlisted booker gets a real DM',r.length===1&&r[0].to==='U098UFMKQHZ'&&!/\[DEV\]/.test(r[0].text),JSON.stringify(r[0]).slice(0,90));
  // QA round 2 (2026-09-24): the engineer notice now honors ALLOW too, so an allowlisted
  // tester assigned as the engineer (e.g. Tara) gets a real DM; a non-listed engineer still
  // redirects (covered above). Booker + engineer both honor ALLOW now.
  r=run({...co,bookerRef:'U098UFMKQHZ',bookerName:'Trish'},trig,engRow('U026N6E1R'));  // engineer Tara, on ALLOW
  check('nr','an allowlisted engineer gets a real DM too',r.length===2&&r[1].to==='U026N6E1R'&&!/\[DEV\]/.test(r[1].text)&&/you are assigned to/.test(r[1].text),JSON.stringify(r[1]).slice(0,90));
});

console.log('\n'+(fail? fail+' failing, '+pass+' passing' : 'all '+pass+' checks pass'));
process.exit(fail?1:0);
