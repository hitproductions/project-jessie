    ['claim check','a rejected booking is not a booking','Booked.',
      {steps:[{action:{tool:'Book_Session'},observation:'[{"status": "REJECTED","reason":"ROOM_OCCUPIED"}]'}]},
      x=>/did not go through/.test(x.output)],
    ['claim check','another tool does not count','Booked.',
      {steps:[{action:{tool:'Room_Availability'},observation:'[{"status": "OK"}]'}]},
      x=>/did not go through/.test(x.output)],
    ['claim check','leaves a claim alone when there are no steps','Booked.',{},x=>/^Booked\./.test(x.output)],
    ['claim check','says so when it cannot tell','Booked.',{},x=>/no intermediateSteps/.test(x.claimProbe)],
    ['claim check','catches a fabricated cancellation','Cancelled "X / Y / TL".',
      {steps:[{action:{tool:'Book_Session'},observation:'[{"status": "CREATED"}]'}]},
      x=>/did not go through/.test(x.output)],
    ['claim check','a real cancellation survives','Cancelled "X / Y / TL".',
      {steps:[{action:{tool:'Cancel_Booking'},observation:'[{"status": "CANCELLED"}]'}]},
      x=>/^Cancelled/.test(x.output)],
    ['claim check','a partial move is not a failure','Moved it to 3pm.',
      {steps:[{action:{tool:'Move_Booking'},observation:'[{"status": "PARTIAL"}]'}]},
      x=>/^Moved/.test(x.output)],
    ['claim check','no claim, no probe','Studio 7 is free.',{},x=>x.claimProbe==='no claim'],
    // A booking named in a reply must have come back from that turn's lookup.
    // She reported PRUNEOK as booked when Find Booking had returned five other
    // bookings and not that one.
    ['lookup titles','flags a booking the lookup did not return',
      '*PRUNEOK / Bea Jose / TL*\n*Room:* Studio 4',
      {steps:[{action:{tool:'Find_Booking',toolInput:{booking_date:'2027-09-09'}},
               observation:'[{"status":"OK","bookings":[{"title":"MUJI / Jeng Gambol / Regie"}]}]'}]},
      x=>/Let me check that again/.test(x.output)&&!/PRUNEOK/.test(x.output)],
    ['lookup titles','passes a booking the lookup did return',
      'I found *MUJI / Jeng Gambol / Regie* in Studio 7.',
      {steps:[{action:{tool:'Find_Booking',toolInput:{booking_date:'2027-09-09'}},
               observation:'[{"status":"OK","bookings":[{"title":"MUJI / Jeng Gambol / Regie"}]}]'}]},
      x=>/^I found \*MUJI/.test(x.output)],
    ['lookup titles','a title the model passed to the tool is allowed',
      '*NEWJOB / Bea Jose / TL* — cancelled.',
      {steps:[{action:{tool:'Find_Booking',toolInput:{title:'NEWJOB / Bea Jose / TL'}},
               observation:'[{"status":"OK","bookings":[]}]'}]},
      x=>/NEWJOB/.test(x.output)&&!/check that again/.test(x.output)],
    ['lookup titles','a booking summary is untouched',
      '*PRUNEOK / Bea Jose / TL*\n*Room:* Studio 4\n\nConfirm to book. (yes/no)',
      {steps:[{action:{tool:'Room_Availability'},observation:'[{"status":"OK"}]'}]},
      x=>/Confirm to book/.test(x.output)&&/PRUNEOK/.test(x.output)],
    ['lookup titles','no steps means no judgement',
      '*PRUNEOK / Bea Jose / TL*',{},x=>/PRUNEOK/.test(x.output)],
    // An offer this turn's own availability check contradicts. It must not
    // require a check to exist — "is studio 3 free?" then "book it" establishes
    // availability a turn earlier, and that flow has to keep working.
    ['offer vs check','a failed check cannot support an offer',SUM,
      {steps:[{action:{tool:'Room_Availability'},observation:'[{"status":"BAD_WINDOW"}]'}]},
      x=>/make sure Studio 8 is free/.test(x.output)&&!/availability check|did not run/.test(x.output)&&!/Confirm to book/.test(x.output)],
    // QA 2026-09-24, twice: junk glued to a timestamp -> BAD_WINDOW, the model retried cleanly and the
    // room came back free, and the guard still refused. The latest answer wins now.
    ['offer vs check','a failed check followed by a good retry is not a contradiction',SUM,
      {steps:[{action:{tool:'Room_Availability'},observation:'[{"status":"BAD_WINDOW"}]'},
              {action:{tool:'Room_Availability'},observation:'[{"status":"OK","asked":{"room":"Studio 8","status":"FREE_BUT_LAST_RESORT"}}]'}]},
      x=>/Confirm to book/.test(x.output)&&!/Hold on|make sure/.test(x.output)],
    ['offer vs check','a busy answer superseded by a free re-check stands',SUM,
      {steps:[{action:{tool:'Room_Availability'},observation:'[{"status":"OK","asked":{"room":"Studio 8","status":"BUSY"}}]'},
              {action:{tool:'Room_Availability'},observation:'[{"status":"OK","asked":{"room":"Studio 8","status":"FREE"}}]'}]},
      x=>/Confirm to book/.test(x.output)&&!/Hold on/.test(x.output)],
    ['offer vs check','a free answer overturned by a busy re-check is refused',SUM,
      {steps:[{action:{tool:'Room_Availability'},observation:'[{"status":"OK","asked":{"room":"Studio 8","status":"FREE"}}]'},
              {action:{tool:'Room_Availability'},observation:'[{"status":"OK","asked":{"room":"Studio 8","status":"BUSY"}}]'}]},
      x=>/already booked for that time/.test(x.output)&&!/Confirm to book/.test(x.output)],
    ['offer vs check','a busy room cannot be offered',SUM,
      {steps:[{action:{tool:'Room_Availability'},observation:'[{"status":"OK","asked":{"room":"Studio 8","status":"BUSY"}}]'}]},
