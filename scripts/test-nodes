      {},x=>/Heads up: 15 minutes is shorter than VO Recording sessions usually run \(1–3 hours\)/.test(x.output)&&!/minimum/i.test(x.output)&&/^\*PROJECT STAR/.test(x.output)],
    ['usual length','a length on the boundary is normal',
      '*X / Y / TL*\n*Time:* 1:00 PM – 4:00 PM\n*Session Type:* VO Recording\n\nConfirm to book. (yes/no)',
      {},x=>!/Heads up/.test(x.output)],
    ['usual length','a type with only a minimum',
      '*X / Y / TL*\n*Time:* 1:00 PM – 3:00 PM\n*Session Type:* Localization Editing\n\nConfirm to book. (yes/no)',
