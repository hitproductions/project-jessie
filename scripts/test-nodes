#!/usr/bin/env bash
# Run every Code node that holds real logic against a table of scenarios,
# offline, before anything is imported.
#
#   ./scripts/test-nodes                  # newest local file of each workflow
#   ./scripts/test-nodes --live           # pull each workflow from n8n first
#   ./scripts/test-nodes MAIN BOOK CANCEL FIND    # four explicit paths
#
# Covers:
#   Gate Context    (main)          via ./scripts/test-gate
#   Guard Probe     (main)          outgoing text: markers, weekday, vocabulary
#   Check Conflicts (Book Session)  duration note, description and title assembly
#   Check Ownership (Cancel Booking) ownership, title resolution
#   Shape Results   (Find Booking)  shaping, and that `creator` never leaks
#
# Each of these has shipped a bug this weekend that only turned up by reading
# output by hand. A node that decides something belongs in here.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

newest() { ls workflows/$1-v*.json 2>/dev/null | sed 's/.*-v\([0-9]*\)\.json/\1 &/' | sort -n | tail -1 | cut -d' ' -f2; }

if [ "${1:-}" = "--live" ]; then
  set -a; . "$here/.env"; set +a
  api() { curl -sS -H "X-N8N-API-KEY: $N8N_API_KEY" "$N8N_BASE_URL/api/v1/workflows/$1"; }
  api uVVYVB2M7kxpLleI > "$tmp/main.json"
  api EUG3sGXkfsJSYIMz > "$tmp/book.json"
  api bAyDw7udhmY0NL38 > "$tmp/cancel.json"
  api yzirq12O227VTFp8 > "$tmp/find.json"
  api t7lwR2km4tfN8DbM > "$tmp/move.json"
  echo "testing the live workflows"
elif [ $# -gt 0 ] && [ $# -ne 5 ]; then
  # 2026-09-25: "test-nodes main <file>" used to fall through to the newest repo files and report on
  # THEM, silently - a candidate that was not the newest file was never tested. Refuse instead.
  echo "usage: ./scripts/test-nodes                          (newest file of each workflow in workflows/)" >&2
  echo "       ./scripts/test-nodes --live                   (what n8n has stored)" >&2
  echo "       ./scripts/test-nodes MAIN BOOK CANCEL FIND MOVE (a candidate: all five paths)" >&2
  exit 64
elif [ $# -eq 5 ]; then
  cp "$1" "$tmp/main.json"; cp "$2" "$tmp/book.json"
  cp "$3" "$tmp/cancel.json"; cp "$4" "$tmp/find.json"; cp "$5" "$tmp/move.json"
  MAIN="$1"
  echo "testing $1, $2, $3, $4, $5"
else
  MAIN="$(newest project-jessie)"
  cp "$(newest project-jessie)" "$tmp/main.json"
  cp "$(newest book-session)"   "$tmp/book.json"
  cp "$(newest cancel-booking)" "$tmp/cancel.json"
  cp "$(newest find-booking)"   "$tmp/find.json"
  cp "$(newest move-booking)"   "$tmp/move.json"
  echo "testing $(newest project-jessie), $(newest book-session), $(newest cancel-booking), $(newest find-booking), $(newest move-booking)"
fi
echo

python3 - "$tmp" <<'PY'
import json,sys,os
t=sys.argv[1]
want={"main.json":["Guard Probe","Booked For"],"book.json":["Check Conflicts"],
      "cancel.json":["Check Ownership"],"find.json":["Shape Results"],
      "move.json":["Resolve Booking","Build Recipients"]}
for f,names in want.items():
    w=json.load(open(os.path.join(t,f)))
    for n in w["nodes"]:
        if n["name"] in names:
            open(os.path.join(t,n["name"].replace(" ","_")+".js"),"w").write(n["parameters"]["jsCode"])
    if f=="book.json":
        for n in w["nodes"]:
            if n["name"]=="New Client?":
                e=n["parameters"]["conditions"]["conditions"][0]["leftValue"].strip()
                open(os.path.join(t,"New_Client_expr.js"),"w").write(e[3:-2] if e.startswith("={{") else e)
PY

node - "$tmp" <<'JS'
const fs=require('fs'), path=require('path'), T=process.argv[2];
const src=n=>fs.readFileSync(path.join(T,n.replace(/ /g,'_')+'.js'),'utf8');
let pass=0, fail=0;
const check=(suite,label,cond,detail)=>{
  if(cond){pass++; console.log('  ok    '+label);}
  else {fail++; console.log('  FAIL  '+label+(detail?'  :: '+detail:''));}
};
// A suite that throws must not take the rest of the run with it. Testing an
// older workflow whose node lacks a variable this suite reads is a legitimate
// thing to do - it should report, not crash, or a regression hiding behind the
// first failure is never seen.
const suite=(name,fn)=>{
  console.log(name);
  try { fn(); }
  catch(e){ fail++; console.log('  FAIL  suite could not run :: '+String(e.message).split('\n')[0]); }
  console.log('');
};

// ── Guard Probe ────────────────────────────────────────────────────────────
suite('Guard Probe — what reaches Slack', ()=>{
  const s=src('Guard Probe');
  // Guard Probe now reads Get Booker (booker line), Gate Context (resolved year,
  // start-only flag), Room Table (the ranking a note is checked against), and
  // probes the tool nodes for isExecuted. ctx lets a case set all of those.
  const ROOMS='- Post Mixing — normally: Studio 7, Studio 8, Studio F, Studio C · also possible: Studio 4, Studio 5, Studio 6\n'
             +'- VO Recording — normally: Studio 7, Studio 8, Studio F, Studio C\n'
             +'- Music Mixing — normally: Studio F · also possible: Studio C';
  const mk=(ctx={})=>name=>{
    if(name==='Get Booker')   return {first:()=>({json:{fields:{Name:'Tara Lim'}}})};
    if(name==='Gate Context') return {first:()=>({json:{dateNotice:ctx.dateNotice||'',pastDateNotice:'',
                                                        startOnlyNotice:ctx.startOnly?'THEY GAVE A START TIME AND NO END TIME.':''}})};
    if(name==='Room Table')   return {first:()=>({json:{roomTable:ctx.roomTable===undefined?ROOMS:ctx.roomTable,
                                                        referenceData:JSON.stringify({types:[{type:'VO Recording',min:60,max:180},{type:'Music Vocal Recording',min:60,max:120},{type:'Localization Editing',min:240,max:null}]})}})};
    if(name==='Booked For')   return {first:()=>({json:{bookedFor:ctx.bookedFor||'',requesterText:ctx.requesterText||''}})};
    if(ctx.executed && Object.prototype.hasOwnProperty.call(ctx.executed,name))
      return {isExecuted:ctx.executed[name],first:()=>({json:{}})};
    return {first:()=>({json:{}})};
  };
  const runCtx=(o,ctx={})=>new Function('$input','$',s)(
    {first:()=>({json: ctx.steps===undefined?{output:o}:{output:o,intermediateSteps:ctx.steps} })},
    mk(ctx))[0].json;
  const run=o=>runCtx(o,{}).output;
  const t=[
    ['collapses ** to *','**Bold** text',x=>x==='*Bold* text'],
    ['fixes a wrong weekday','*Date:* September 9, 2027 (Wed)',x=>x.includes('(Thu)')],
    ['fixes a named wrong weekday','on Wednesday, September 9, 2027',x=>x.includes('Thursday')],
    ['leaves a right weekday alone','*Date:* September 9, 2027 (Thu)',x=>x.includes('(Thu)')],
    ['removes "priority rooms"','The priority rooms are Studio 7 and Studio 8.',x=>!/priority/i.test(x)],
    ['removes "last-resort room"','Studio F is a last-resort room for this.',x=>!/last.resort/i.test(x)],
    ['removes "prioritized"','rooms prioritized for VO Recording',x=>!/prioriti/i.test(x)],
    ['keeps the article readable','The priority rooms are free.',x=>/^The rooms/.test(x)],
    ['normalises an embellished marker','a\n\nConfirm to cancel both. (y/n)',x=>x.endsWith('Confirm to cancel.')&&/Reply only with "yes" to cancel, or "no" to keep it\./.test(x)],
    ['supplies a missing suffix','a\n\nConfirm to book',x=>x.endsWith('Confirm to book.')&&/Reply only with "yes" to book, or "no" to change anything\./.test(x)],
    ['leaves a mid-sentence mention','I will ask you to confirm to book later. Which room?',x=>x.includes('confirm to book later')],
    ['falls back on empty output','',x=>x.length>10],
    // Vocabulary and corruption found in the 2026-08-30 QA run.
    ['strips the BLOCKED prefix','BLOCKED - "X / Y / TL" was booked by Howard Lim.',x=>!/BLOCKED/.test(x)],
    ['removes "deviation:" in parentheses','*Room:* Studio 5 (deviation: another room for post mixing)',
      x=>!/deviation/i.test(x)&&x.includes('(another room')],
    ['rewrites "is a deviation from the usual rooms"','Studio 3 is a deviation from the usual rooms for VO Recording.',
      x=>!/deviation/i.test(x)&&/is not one of the usual rooms/.test(x)],
    // v100 shipped "Studio 3 is a exception for VO Recording" - the noun was
    // swapped and the article left behind. Same trap the priority/last-resort
    // list already documents: a replacement must swallow its article.
    ['rewrites "is a deviation for"','*Note:* Studio 3 is a deviation for VO Recording (normally Studio 7).',
      x=>!/deviation/i.test(x)&&/is not a usual room for VO Recording/.test(x)],
    // "a exception" is the specific breakage v100 shipped. "a usual room" is
    // correct English and must not be flagged.
    ['never leaves a stranded article','Studio 3 is a deviation for VO Recording.',
      x=>!/\ba\s+exception\b/i.test(x)],
    ['a bare deviation still becomes an exception','That would be a deviation.',
      x=>/\ban exception\b/i.test(x)],
    // The rules are numbered for the model. A requester has no rule 1.
    ['drops a cited rule number',
      'Studio 7 is taken, and since rule 1 says we never move an existing booking, it is not available.',
      x=>!/rule\s*\d/i.test(x)&&/since we never move an existing booking/.test(x)],
    // v115 stripped the citation and left the sentence starting lowercase.
    ['recapitalises after a sentence-initial citation',
      'Studio 6 is taken.\n\nRule 1 says we never delete an existing booking to clear a room.',
      x=>!/rule\s*\d/i.test(x)&&/\n\nWe never delete an existing booking/.test(x)],
    ['recapitalises at the very start','Rule 3 states you cannot do that.',
      x=>/^You cannot do that\./.test(x)],
    // v116 turned "rule 1 is absolute" into "the booking rules is absolute".
    ['keeps verb agreement on a bare citation','As much as you need it, rule 1 is absolute: we never delete a booking.',
      x=>!/rule\s*\d/i.test(x)&&!/\brules\s+is\b/i.test(x)&&/rule is absolute/.test(x)],
    ['plural form still agrees','The three unoverridable rules is what stops that.',
      x=>!/\brules\s+is\b/i.test(x)],
    ['drops a bare rule citation','Per rule 2, only you can cancel it.',
      x=>!/rule\s*\d/i.test(x)&&/only you can cancel it/.test(x)],
    ['rewrites "unoverridable rules"','That is one of the three unoverridable rules.',
      x=>!/unoverridable/i.test(x)&&/the booking rules/.test(x)],
    ['relabels Booking Owner','*Booking Owner:* Tara Lim',x=>x.startsWith('*Booked by:* Tara Lim')],
    // "*Bookedby:*" - no space - went out on 2026-08-30, and the booker repair
    // below would not have matched it.
    ['relabels Bookedby','*Bookedby:* Tara Inf',x=>x.trim()==='*Booked by:* Tara Lim'],
    ['repairs a corrupted booker name','*Booked by:* Tara Inf',x=>x.trim()==='*Booked by:* Tara Lim'],
    ['leaves the right booker alone','*Booked by:* Tara Lim',x=>x.trim()==='*Booked by:* Tara Lim'],
    ['does not touch other lines','*Client:* Bea Jose\n*Booked by:* Tara Inf',
      x=>x.includes('*Client:* Bea Jose')&&x.includes('*Booked by:* Tara Lim')],
  ];
  for(const [label,input,ok] of t){ let r; try{r=run(input);}catch(e){r='THREW '+e.message;} check('gp',label,ok(r),r.slice(0,70)); }

  // ── the five findings from the A/B/M groups, 2026-08-30 ──────────────────
  const SUM='*M13TEST / Jem Lim / TL*\n*Time:* 1:00 PM – 4:00 PM\n*Room:* Studio 8\n\nConfirm to book. (yes/no)';
  const ctx2027={dateNotice:'THE DATE UNDER DISCUSSION IS Thursday, 9 September 2027.'};
  // Each group is gated on a marker from its own fix, so the four Guard Probe
  // fixes can go back one at a time (v102 shipped all four at once and hung the
  // node) and every build reports honestly on what it actually contains.
  const GROUPS=[
    ['undated weekday','refYear'],
    ['note vs ranking','roomTable'],
    ['assumed duration','startOnlyNotice'],
    ['claim check','claimProbe'],
    ['lookup titles','lookup did not return'],
    ['offer vs check','contradicts ---'],
    ['dated weekday survives','\\(\\?!\\\\d\\)'],
    ['booker is not always you','a near-miss of the real one'],
    ['booked for','booked for a colleague: the summary says so'],
    ['usual length','an unusual length, said BEFORE the yes'],
  ];
  const t2=[
    // a date with no year — both older patterns need one
    ['undated weekday','fixes an undated weekday','Studio 7 is taken next Wednesday, September 9.',ctx2027,
      x=>/next Thursday, September 9/.test(x.output)],
    ['undated weekday','leaves a correct undated weekday','that is Thursday, September 9.',ctx2027,
      x=>/Thursday, September 9/.test(x.output)],
    ['undated weekday','undated weekday needs a resolved year','on Wednesday, September 9.',{},
      x=>/Wednesday/.test(x.output)],
    // a note the ranking contradicts
    ['note vs ranking','drops a note the ranking contradicts',
      '*Room:* Studio 7\n*Note:* Studio 7 is outside the usual rooms for Post Mixing (so it is one of them).\n\nConfirm to book. (yes/no)',{},
      x=>!/\*Note:\*/.test(x.output)&&/\*Room:\* Studio 7/.test(x.output)],
    ['note vs ranking','keeps a note the ranking supports',
      '*Room:* Studio 3\n*Note:* Studio 3 is outside the usual rooms for Post Mixing.\n\nConfirm to book. (yes/no)',{},
      x=>/\*Note:\*/.test(x.output)],
    ['note vs ranking','keeps a note when the ranking is unreadable',
      '*Note:* Studio 7 is outside the usual rooms for Post Mixing.\n\nConfirm to book. (yes/no)',{roomTable:''},
      x=>/\*Note:\*/.test(x.output)],
    // a duration nobody asked for
    ['assumed duration','states an assumed duration',SUM,{startOnly:true},x=>/^Assuming 3 hours/.test(x.output)],
    ['assumed duration','does not restate one already given',SUM.replace('*M13','Assuming 3 hours.\n\n*M13'),{startOnly:true},
      x=>(x.output.match(/Assuming/g)||[]).length===1],
    ['assumed duration','says nothing when a range was given',SUM,{},x=>!/Assuming/.test(x.output)],
    // a claim with nothing behind it
    // The agent reports its own tool calls on this node's input, so the check
    // needs no node lookup - $('Book Session') hangs the task runner.
    ['claim check','rewrites a booking that never happened','Booked. That is a bit shorter than usual.',
      {steps:[]},x=>/did not go through/.test(x.output)&&!/^Booked/.test(x.output)],
    ['claim check','leaves a real booking alone','Booked.',
      {steps:[{action:{tool:'Book_Session'},observation:'[{"status": "CREATED","event_id":"x"}]'}]},
