  // These cover the four Guard Probe fixes written for v102. That build made the
  // node time out at 60s on every message - it reached the task runner and
  // hung, and Guard Probe had been erroring on every reply until it was rolled
  // back to the v101 code in v103. The checks stay as the specification for
  // putting them back one at a time; they are skipped while the code is absent
  // so a rolled-back build still reports clean rather than permanently red.
  for(const [gname,marker] of GROUPS){
    const cases=t2.filter(c=>c[0]===gname);
    if(!new RegExp(marker).test(s)){ console.log('  skip  '+cases.length+' checks — '+gname+' is not in this build'); continue; }
    for(const [,label,input,ctx,ok] of cases){ let r; try{r=runCtx(input,ctx);}catch(e){r={output:'THREW '+e.message,claimProbe:'THREW'};}
      check('gp',label,ok(r),String(r.output).slice(0,70)); }
  }
});

// ── Check Conflicts ────────────────────────────────────────────────────────
suite('Check Conflicts — the booking guards', ()=>{
  const whole=src('Check Conflicts');
  const i=whole.indexOf('const segs ='), j=whole.indexOf('// --- room ranking');
  const body=whole.slice(i,j);
  const run=(client,summary,desc,eng,recName,recTech)=>{
    const REQ={client,summary,description:desc,engineer:eng};
    const $=()=>({first:()=>({json:{fields:{'Name':recName,'Technical Requirements':recTech}}})});
    return new Function('REQ','$',body+'; return {d:finalDescription,s:finalSummary,c:clientGiven};')(REQ,$);
  };
  const D='| Booked by: Tara Lim | ref: U1', E='Tara Lim (Post Engineer)', T='Long sessions';
  let r=run('Jem Lim','X / Jem Lim / TL',D,E,'Jem Lim',T);
  check('cc','engineer is in the description',/^Engineer: Tara Lim/.test(r.d),r.d.slice(0,60));
  check('cc','no leading pipe',!/^\s*\|/.test(r.d),r.d.slice(0,30));
  // v50 (2026-09-28): client Technical Requirements are no longer read or written.
  check('cc','client tech requirements are no longer written',!r.d.includes(T)&&!/Tech requirements/.test(r.d),r.d);
  r=run('','X / Jem Lim / TL',D,E,'Jem Lim',T);
  check('cc','client recovered from the title',r.c==='Jem Lim',JSON.stringify(r.c));
  r=run('','M5 - Howard',D,E,'Leslie Tan','Atmos rig');
  check('cc','internal room gets no client',r.c===''&&!/Tech requirements/.test(r.d),JSON.stringify(r.c));
  r=run('Jem Lim','X / jem lim / TL',D,E,'Jem Lim',T);
  check('cc','client name spelling corrected',r.s==='X / Jem Lim / TL',r.s);
  r=run('Jem Lim','X / Someone Else / TL',D,E,'Jem Lim',T);
  check('cc','a different name is left alone',r.s==='X / Someone Else / TL',r.s);
  r=run('Dante Nora','BABY / dante nora / DR x PL',D,E,'Dante Nora',T);
  check('cc','music initials survive',r.s==='BABY / Dante Nora / DR x PL',r.s);
});

// ── On-behalf bookings still need a real client ──────────────────────────────
suite('Check Conflicts — booked-for is never the client', ()=>{
  const whole=src('Check Conflicts');
  const i=whole.indexOf('// --- on-behalf bookings');
  const j=whole.indexOf('// Rooms and session types are passed in by Room Table');
  const body=whole.slice(i,j);
  const run=REQ=>{ const r=new Function('REQ',body+'\nreturn null;')(REQ); return r?r[0].json.reason:'CLEAR'; };
  const forK='Engineer: Tara Lim (Post Engineer) | Booked by: Howard Luistro (for Kristine Trocino) | ref: U1';
  check('bf','on-behalf external, no client but booked-for in the title -> MISSING_CLIENT',run({description:forK,bookingType:'External',client:'',summary:'SMOKETEST2 / Kristine Trocino / TL'})==='MISSING_CLIENT');
  // v49: no client at all is allowed; the title drops the client segment
  check('bf','on-behalf external, no client, PROJECT / initials -> CLEAR',run({description:forK,bookingType:'External',client:'',summary:'SMOKETEST2 / TL'})==='CLEAR');
  check('bf','on-behalf external, client IS the booked-for -> MISSING_CLIENT',run({description:forK,bookingType:'External',client:'Kristine Trocino',summary:'X / Kristine Trocino / TL'})==='MISSING_CLIENT');
  check('bf','on-behalf external, booked-for in the title client slot -> MISSING_CLIENT',run({description:forK,bookingType:'External',client:'Acme Records',summary:'X / Kristine Trocino / TL'})==='MISSING_CLIENT');
  if(/v76: client work under the four types/.test(whole)){   // v76: the guard ran only for "External" - no booking has that type since v73
    check('bf','v76: on-behalf Advertising, client IS the booked-for -> MISSING_CLIENT',run({description:forK,bookingType:'Advertising',client:'Kristine Trocino',summary:'X / Kristine Trocino / TL'})==='MISSING_CLIENT');
    check('bf','v76: on-behalf Entertainment, booked-for in the title -> MISSING_CLIENT',run({description:forK,bookingType:'Entertainment',client:'',summary:'X / Kristine Trocino / TL'})==='MISSING_CLIENT');
    check('bf','v76: on-behalf Advertising, distinct real client -> CLEAR',run({description:forK,bookingType:'Advertising',client:'Acme Records',summary:'X / Acme Records / TL'})==='CLEAR');
    check('bf','v76: on-behalf Internal / Personal -> not this guard',run({description:forK,bookingType:'Internal',client:'',summary:'X / Kristine Trocino / TL'})==='CLEAR'&&run({description:forK,bookingType:'Personal',client:'',summary:'X / Kristine Trocino / TL'})==='CLEAR');
  }
  check('bf','on-behalf external, distinct real client -> CLEAR',run({description:forK,bookingType:'External',client:'Acme Records',summary:'SMOKETEST2 / Acme Records / TL'})==='CLEAR');
  check('bf','self-booking (no for-person) -> CLEAR, guard skipped',run({description:'Engineer: Tara Lim | Booked by: Howard Luistro | ref: U1',bookingType:'External',client:'',summary:'X / Acme / TL'})==='CLEAR');
  // Booked For hands over a canonical name; the client slot may hold only the first name or a nickname.
  const run2=(REQ)=>{ const STAFF=[{Name:'Japs Concepcion',Info:'Accounts Lead, Goes by Japs, Joana Paula, JPC.'}];
    const $=name=>({all:()=>name==='All Bookers'?STAFF.map(f=>({json:{fields:f}})):[]});
    const r=new Function('REQ','$',body+'\nreturn null;')(REQ,$); return r?r[0].json.reason:'CLEAR'; };
  const forJ='Engineer: Daryl Reyes (Music Engineer) | Booked by: Camy Caridad (for Japs Concepcion) | ref: U1';
  check('bf','canonical for-name, nickname in the client slot -> MISSING_CLIENT',run2({description:forJ,bookingType:'External',client:'Japs',summary:'SUSHI / Japs / DR'})==='MISSING_CLIENT');
  check('bf','canonical for-name, real client -> CLEAR',run2({description:forJ,bookingType:'External',client:'Pael',summary:'SUSHI / Pael / DR'})==='CLEAR');
  // v54: an in-house arranger booked-for AND client on record (their own project) is allowed
  if(body.indexOf('_bfIsClient')>=0){
    const run3=(REQ,clientRows)=>{ const STAFF=[{Name:'Brian Cua',Info:'Music Arranger, Goes by Brian, BC.'}];
      const $=name=>({all:()=>name==='All Bookers'?STAFF.map(f=>({json:{fields:f}})):name==='Get Client'?(clientRows||[]).map(j=>({json:j})):[]});
      const r=new Function('REQ','$',body+'\nreturn null;')(REQ,$); return r?r[0].json.reason:'CLEAR'; };
    const forB='Engineer: Daryl Reyes (Music Engineer) | Booked by: Camy Caridad (for Brian Cua) | ref: U1';
    check('bf','an arranger booked-for who is also a client on record may be the client (v54)',run3({description:forB,bookingType:'External',client:'Brian Cua',summary:'ECHO / Brian Cua / DR x BC'},[{id:'rb',fields:{Name:'Brian Cua'}}])==='CLEAR');
    check('bf','...but not someone with no client record',run3({description:forB,bookingType:'External',client:'Brian Cua',summary:'ECHO / Brian Cua / DR x BC'},[])==='MISSING_CLIENT');
  }
  check('bf','on-behalf but Personal (not external) -> CLEAR, guard skipped',run({description:forK,bookingType:'Personal',client:'',summary:'X / Kristine Trocino / TL'})==='CLEAR');
});

