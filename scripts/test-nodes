  x=run({engineer:'Daryl',session_type:'Localization Dubbing',description:'Engineer: Daryl'+D,summary:'NET-KUBA / JP'});
  check('st','Localization initials are still corrected (PENDING 49)',!x.r&&x.REQ.summary==='NET-KUBA / DR',x.REQ.summary);
  x=run({engineer:'',description:'Booked by: Camy Caridad | ref: U1',summary:'M2 - Camy'});
  check('st','no engineer, nothing to check',!x.r&&x.REQ.summary==='M2 - Camy');
  x=run({engineer:'Daryl',description:'Engineer: Daryl'+D,summary:'X / Acme / D'},[]);
