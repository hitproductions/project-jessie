  check('v182','two dates under discussion: left alone',st({datesUnderDiscussion:'2027-09-30,2027-10-07'},B,'2027-10-01T14:00:00+08:00')==='2027-10-01T14:00:00+08:00');
  check('v182','no date under discussion: left alone',st({datesUnderDiscussion:''},B,'2027-10-01T14:00:00+08:00')==='2027-10-01T14:00:00+08:00');
  check('v182','all-day: start becomes the day, end the day after',st(G,B,'2027-10-01')==='2027-09-30'&&en(G,B,'2027-10-02')==='2027-10-01',en(G,B,'2027-10-02'));
  check('v182','all-day already right: left alone',st(G,B,'2027-09-30')==='2027-09-30'&&en(G,B,'2027-10-01')==='2027-10-01');
  check('v182','the typed time range still wins (v167) alongside the date fix',st(G,{saidWords:'tomorrow 2pm to 4pm',timeStart:'14:00',timesMentioned:['14:00','16:00']},'2027-10-01T15:00:00+08:00')==='2027-09-30T14:00:00+08:00',st(G,{saidWords:'tomorrow 2pm to 4pm',timeStart:'14:00',timesMentioned:['14:00','16:00']},'2027-10-01T15:00:00+08:00'));
  check('v182','an empty start stays empty (MISSING_DETAILS still asks)',st(G,B,'')==='');
  { const mv=W.nodes.find(n=>n.name==='Move Booking').parameters.workflowInputs.value;
    if(/changeJustBooked/.test(mv.new_start_iso||'')){
      const mk2=key=>{ const e=mv[key]; const i=e.indexOf('{{'), j=e.lastIndexOf(' }}'); let x=e.slice(i+2,j).trim(); const k=x.indexOf("$fromAI("); let depth=0,end=k; for(;end<x.length;end++){ if(x[end]==='(') depth++; else if(x[end]===')'){ depth--; if(depth===0){ end++; break; } } } x=x.slice(0,k)+'__m'+x.slice(end);
        return (bf,m)=>new Function('$','__m','return ('+x+');')(n=>({first:()=>({json:n==='Booked For'?bf:{}})}),m); };
      const ms=mk2('new_start_iso'), me=mk2('new_end_iso');
      const JB={changeJustBooked:true,moveStart:'15:00',moveEnd:'17:00',justBooked:{iso:'2027-11-17'}};
      check('v185','Move Booking gets 3-5 PM for the change, whatever the model sends',ms(JB,'2027-11-17T15:00:00+08:00')==='2027-11-17T15:00:00+08:00'&&me(JB,'2027-11-17T16:00:00+08:00')==='2027-11-17T17:00:00+08:00',me(JB,'2027-11-17T16:00:00+08:00'));
      check('v185','a new day the model worked out is kept ("tomorrow 3pm")',ms(JB,'2027-11-18T15:00:00+08:00')==='2027-11-18T15:00:00+08:00');
      check('v185','no change after a booking: the model\'s times stand',me({},'2027-11-17T16:00:00+08:00')==='2027-11-17T16:00:00+08:00');
      check('v185','a room-only change (no times worked out): the model\'s times stand',me({changeJustBooked:true,justBooked:{iso:'2027-11-17'}},'2027-11-17T16:00:00+08:00')==='2027-11-17T16:00:00+08:00');
    } }
  if(/timeForced/.test(v.start_iso)){
    const F={saidWords:'book studio 7 tomorrow 2pm to 4pm actually make it 3pm instead',timeStart:'15:00',timeEnd:'17:00',timeForced:true,timesMentioned:['14:00','16:00','15:00','17:00']};
    check('v183','a forced change wins even though 4 PM was mentioned before',st(G,F,'2027-09-30T14:00:00+08:00')==='2027-09-30T15:00:00+08:00'&&en(G,F,'2027-09-30T16:00:00+08:00')==='2027-09-30T17:00:00+08:00',en(G,F,'2027-09-30T16:00:00+08:00'));
    check('v183','not forced: a mentioned time still stands',en(G,{...F,timeForced:false},'2027-09-30T16:00:00+08:00')==='2027-09-30T16:00:00+08:00');
  }
});

