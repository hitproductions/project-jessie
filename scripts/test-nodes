    ['v162','a client only in the three-segment title is a client','*BUZZ / Jem Lim / TL*\n*Session Type:* VO Recording\n\nConfirm to book. (yes/no)',
      {requesterText:'book it'},x=>/Confirm to book\.$/.test(x.output)],
    ['v162','a Localization two-segment title is not "no client"','*NET-KUBA / FP*\n*Session Type:* Localization Dubbing\n\nConfirm to book. (yes/no)',
      {requesterText:'book it'},x=>/Confirm to book\.$/.test(x.output)],
    ['v162','a two-segment studio title with no Client line asks','*ORANGE / TL*\n*Session Type:* VO Recording\n\nConfirm to book. (yes/no)',
      {requesterText:'book studio 7'},x=>/Who is the client/.test(x.output)],
    // QA B2 2026-09-25: the summary shows who the booking is for, from Booked For.
    ['booked for','the booker line gains "(for X)"','*SUSHI / Pael / DR*\n*Booked by:* Tara Lim\n\nConfirm to book. (yes/no)',
      {bookedFor:'Japs Concepcion'},x=>/\*Booked by:\* Tara Lim \(for Japs Concepcion\)/.test(x.output)],
    ['booked for','an existing "(for X)" is left alone','*SUSHI / Pael / DR*\n*Booked by:* Tara Lim (for Japs)\n\nConfirm to book. (yes/no)',
      {bookedFor:'Japs Concepcion'},x=>/Tara Lim \(for Japs\)\n/.test(x.output)&&!/Japs Concepcion/.test(x.output)],
    ['booked for','no colleague, no change','*SUSHI / Pael / DR*\n*Booked by:* Tara Lim\n\nConfirm to book. (yes/no)',
      {},x=>/\*Booked by:\* Tara Lim\n/.test(x.output)],
    ['offer vs check','only applies to a booking summary','Studio 8 is free in that window.',
      {steps:[{action:{tool:'Room_Availability'},observation:'[{"status":"BAD_WINDOW"}]'}]},
      x=>/^Studio 8 is free/.test(x.output)],

    // v120. The undated corrector was undoing the dated one: `\d{1,2}` backtracked
    // past its own year lookahead, matched the first digit of a two-digit day, and
    // printed the weekday of the 1st instead. Two-digit days are the whole point of
    // these cases - a single-digit day never reproduced it.
    ['dated weekday survives','corrects a dated weekday with a two-digit day',
      'I found this booking on next Wednesday, September 10, 2027:',ctx2027,
      x=>/next Friday, September 10, 2027/.test(x.output)],
    ['dated weekday survives','leaves a correct two-digit dated weekday alone',
      'We go live on Friday, September 25, 2026.',ctx2027,
      x=>/Friday, September 25, 2026/.test(x.output)],
    ['dated weekday survives','still corrects an undated two-digit weekday',
      'Your slot is Monday, September 22.',{dateNotice:'THE DATE UNDER DISCUSSION IS Thursday, 9 September 2027.'},
      x=>/Wednesday, September 22/.test(x.output)],

    // v120. "Booked by:" is not always the requester - a cancel or a lookup shows
    // someone else's booking, and the rewrite was relabelling it as theirs.
    ['booker is not always you','keeps a booker a tool reported',
      'I found this booking:\n*Booked by:* Howard Luistro',
      {steps:[{action:{tool:'Find_Booking',toolInput:{date:'2027-09-10'}},
               observation:'[{"title":"GUARDCHK / Bea Jose / HL","booker":"Howard Luistro"}]'}]},
      x=>/\*Booked by:\* Howard Luistro/.test(x.output)],
    ['booker is not always you','keeps a stranger\'s name with no steps at all',
      'I found this booking:\n*Booked by:* Howard Luistro',{},
      x=>/\*Booked by:\* Howard Luistro/.test(x.output)],
    ['booker is not always you','still repairs a corrupted booker name',
      'Here is the summary:\n*Booked by:* Tara Inf',{},
      x=>/\*Booked by:\* Tara Lim/.test(x.output)],
  ];
  // These cover the four Guard Probe fixes written for v102. That build made the
  // node time out at 60s on every message - it reached the task runner and
  // hung, and Guard Probe had been erroring on every reply until it was rolled
  // back to the v101 code in v103. The checks stay as the specification for
  // putting them back one at a time; they are skipped while the code is absent
  // so a rolled-back build still reports clean rather than permanently red.
  for(const [gname,marker] of GROUPS){
    const cases=t2.filter(c=>c[0]===gname);
    if(!new RegExp(marker).test(s)){ console.log('  skip  '+cases.length+' checks — '+gname+' is not in this build'); continue; }
    for(const [,label,input,ctx,ok] of cases){ let r; try{r=runCtx(input,ctx);}catch(e){r={output:'THREW '+e.message,claimProbe:'THREW'};}
      check('gp',label,ok(r),String(r.output).slice(0,70)); }
  }
});

// ── Check Conflicts ────────────────────────────────────────────────────────
suite('Check Conflicts — the booking guards', ()=>{
  const whole=src('Check Conflicts');
  const i=whole.indexOf('const segs ='), j=whole.indexOf('// --- room ranking');
  const body=whole.slice(i,j);
  const run=(client,summary,desc,eng,recName,recTech)=>{
    const REQ={client,summary,description:desc,engineer:eng};
    const $=()=>({first:()=>({json:{fields:{'Name':recName,'Technical Requirements':recTech}}})});
    return new Function('REQ','$',body+'; return {d:finalDescription,s:finalSummary,c:clientGiven};')(REQ,$);
  };
  const D='| Booked by: Tara Lim | ref: U1', E='Tara Lim (Post Engineer)', T='Long sessions';
  let r=run('Jem Lim','X / Jem Lim / TL',D,E,'Jem Lim',T);
  check('cc','engineer is in the description',/^Engineer: Tara Lim/.test(r.d),r.d.slice(0,60));
  check('cc','no leading pipe',!/^\s*\|/.test(r.d),r.d.slice(0,30));
  // v50 (2026-09-28): client Technical Requirements are no longer read or written.
  check('cc','client tech requirements are no longer written',!r.d.includes(T)&&!/Tech requirements/.test(r.d),r.d);
  r=run('','X / Jem Lim / TL',D,E,'Jem Lim',T);
  check('cc','client recovered from the title',r.c==='Jem Lim',JSON.stringify(r.c));
  r=run('','M5 - Howard',D,E,'Leslie Tan','Atmos rig');
  check('cc','internal room gets no client',r.c===''&&!/Tech requirements/.test(r.d),JSON.stringify(r.c));
  r=run('Jem Lim','X / jem lim / TL',D,E,'Jem Lim',T);
  check('cc','client name spelling corrected',r.s==='X / Jem Lim / TL',r.s);
  r=run('Jem Lim','X / Someone Else / TL',D,E,'Jem Lim',T);
  check('cc','a different name is left alone',r.s==='X / Someone Else / TL',r.s);
  r=run('Dante Nora','BABY / dante nora / DR x PL',D,E,'Dante Nora',T);
  check('cc','music initials survive',r.s==='BABY / Dante Nora / DR x PL',r.s);
});

// ── On-behalf bookings still need a real client ──────────────────────────────
suite('Check Conflicts — booked-for is never the client', ()=>{
  const whole=src('Check Conflicts');
  const i=whole.indexOf('// --- on-behalf bookings');
  const j=whole.indexOf('// Rooms and session types are passed in by Room Table');
  const body=whole.slice(i,j);
  const run=REQ=>{ const r=new Function('REQ',body+'\nreturn null;')(REQ); return r?r[0].json.reason:'CLEAR'; };
  const forK='Engineer: Tara Lim (Post Engineer) | Booked by: Howard Luistro (for Kristine Trocino) | ref: U1';
  check('bf','on-behalf external, no client but booked-for in the title -> MISSING_CLIENT',run({description:forK,bookingType:'External',client:'',summary:'SMOKETEST2 / Kristine Trocino / TL'})==='MISSING_CLIENT');
  // v49: no client at all is allowed; the title drops the client segment
  check('bf','on-behalf external, no client, PROJECT / initials -> CLEAR',run({description:forK,bookingType:'External',client:'',summary:'SMOKETEST2 / TL'})==='CLEAR');
  check('bf','on-behalf external, client IS the booked-for -> MISSING_CLIENT',run({description:forK,bookingType:'External',client:'Kristine Trocino',summary:'X / Kristine Trocino / TL'})==='MISSING_CLIENT');
  check('bf','on-behalf external, booked-for in the title client slot -> MISSING_CLIENT',run({description:forK,bookingType:'External',client:'Acme Records',summary:'X / Kristine Trocino / TL'})==='MISSING_CLIENT');
  check('bf','on-behalf external, distinct real client -> CLEAR',run({description:forK,bookingType:'External',client:'Acme Records',summary:'SMOKETEST2 / Acme Records / TL'})==='CLEAR');
  check('bf','self-booking (no for-person) -> CLEAR, guard skipped',run({description:'Engineer: Tara Lim | Booked by: Howard Luistro | ref: U1',bookingType:'External',client:'',summary:'X / Acme / TL'})==='CLEAR');
  // Booked For hands over a canonical name; the client slot may hold only the first name or a nickname.
  const run2=(REQ)=>{ const STAFF=[{Name:'Japs Concepcion',Info:'Accounts Lead, Goes by Japs, Joana Paula, JPC.'}];
    const $=name=>({all:()=>name==='All Bookers'?STAFF.map(f=>({json:{fields:f}})):[]});
    const r=new Function('REQ','$',body+'\nreturn null;')(REQ,$); return r?r[0].json.reason:'CLEAR'; };
  const forJ='Engineer: Daryl Reyes (Music Engineer) | Booked by: Camy Caridad (for Japs Concepcion) | ref: U1';
  check('bf','canonical for-name, nickname in the client slot -> MISSING_CLIENT',run2({description:forJ,bookingType:'External',client:'Japs',summary:'SUSHI / Japs / DR'})==='MISSING_CLIENT');
  check('bf','canonical for-name, real client -> CLEAR',run2({description:forJ,bookingType:'External',client:'Pael',summary:'SUSHI / Pael / DR'})==='CLEAR');
  check('bf','on-behalf but Personal (not external) -> CLEAR, guard skipped',run({description:forK,bookingType:'Personal',client:'',summary:'X / Kristine Trocino / TL'})==='CLEAR');
});

// ── Booked For: "for <someone in Bookers>" means the booking is for them ──────
suite('Booked For — deterministic on-behalf detection', ()=>{
  let code; try { code=src('Booked For'); } catch(e) { console.log('  skip  Booked For is not in this build'); return; }
  const STAFF=[
    {Name:'Japs Concepcion',Initials:'JPC',Info:'Accounts Lead, Goes by Japs, Joana Paula, JPC.'},
    {Name:'Kristine Trocino',Initials:'KT',Info:'BD Associate, Goes by Kristine, Tin, Kite, KT.'},
    {Name:'Camy Caridad',Initials:'CC',Info:'Voice Caster, Goes by Camy, Camille, CC.'},
    {Name:'John Cutangco',Initials:'JC',Info:'Loc Engineer, Goes by John, Pusa, JC.'},
    {Name:'John Rivera',Initials:'JR',Info:'Goes by Johnny, JR.'},
    {Name:'Dennis Cham',Initials:'DC',Info:'Chairman, Sir Dennis, Dennis, DC.'}];
  const BOT={bot_id:'B1'};
  // msgs newest first; the last element of hist is the oldest.
  const run=(trigger,hist,opts={})=>{
    const $=name=>{
      if(name==='Get Booker') return {first:()=>({json:{fields:{Name:opts.requester||'Camy Caridad'}}})};
      if(name==='All Bookers') { if(opts.broken) throw new Error('airtable down'); return {all:()=>STAFF.map(f=>({json:{fields:f}}))}; }
      if(name==='Slack Trigger') return {first:()=>({json:trigger})};
      if(name==='Gate Context') return {first:()=>({json:{epoch:opts.epoch||''}})};
      if(name==='Get Recent Messages') return {all:()=>hist.map(j=>({json:j}))};
      return {first:()=>({json:{}}),all:()=>[]};
    };
    return new Function('$',code)($)[0].json;
  };
  const U=(ts,text)=>({ts:String(ts),text,user:'UCAMY'}), J=(ts,text)=>Object.assign({ts:String(ts),text},BOT);
  // The exact QA B2 conversation, at the "yes" turn.
  let h=[U(20,'yes'),J(19,'*Sushi / Pael / DJ* ... Confirm to book.'),U(18,'Ok stud c'),J(17,'Studio F is taken...'),U(16,'Daryl'),
         J(15,'Who is the assigned engineer?'),U(14,'Client is Pael. Japs is the caster. Project Sushi. vocal recording'),
         J(13,'Who is the client?'),U(12,'Client is'),J(11,'Who is the client, and what is Japs?'),U(10,'Book Studio F for Japs next Thursday from 1pm to 4pm')];
  let r=run(h[0],h);
  check('bfd','QA B2: "for Japs" is found at the yes turn',r.bookedFor==='Japs Concepcion',JSON.stringify(r));
  check('bfd','and the model is told not to ask who Japs is',/do not ask who they are/.test(r.notice)&&/\(for Japs Concepcion\)/.test(r.notice));
  r=run(U(2,'Book Studio F for Jem Lim next Thursday 1-4pm'),[]);
  check('bfd','a client (not in Bookers) is not a booked-for',r.bookedFor==='');
  r=run(U(2,'Book Studio 7 for John Smith tomorrow 2-4pm'),[]);
  check('bfd','"for John Smith" is a client, not John Cutangco',r.bookedFor==='');
  r=run(U(2,'Book Studio 7 on behalf of Kristine Trocino tomorrow 2-4pm'),[]);
  check('bfd','"on behalf of" a full name',r.bookedFor==='Kristine Trocino');
  r=run(U(2,'Book Studio F for Japs Next Thursday 1-4pm'),[]);
  check('bfd','a capitalised weekday after the name still counts',r.bookedFor==='Japs Concepcion');
  r=run(U(2,'Book Studio 7 for Camy tomorrow 2-4pm'),[]);
  check('bfd','booking "for" yourself is not on-behalf',r.bookedFor==='');
  r=run(U(2,'Book Studio 7 for John tomorrow'),[]);
  check('bfd','an ambiguous first name is skipped',r.bookedFor==='');
  r=run(U(2,'Book Studio 7 for 2 hours for a VO recording for next Thursday'),[]);
  check('bfd','"for 2 hours / a VO recording / next Thursday" match no one',r.bookedFor==='');
  r=run(U(2,'Book Studio F for the chairman tomorrow'),[]);
  check('bfd','a role word does not match a person',r.bookedFor==='');
  h=[U(9,'yes'),J(8,'summary... Confirm to book.'),U(7,'actually it is for Kristine'),J(6,'Which room?'),U(5,'Book a VO session tomorrow 2-4pm, project X')];
  r=run(h[0],h);
  check('bfd','a follow-up "it is for Kristine" counts',r.bookedFor==='Kristine Trocino');
  h=[U(9,'yes'),J(8,'summary... Confirm to book.'),U(7,'Book Studio 3 tomorrow 2-4pm, project Y'),J(6,'Booked.'),U(5,'Book Studio F for Japs next Thursday')];
  r=run(h[0],h);
  check('bfd','a finished booking ends the scan (no carry-over)',r.bookedFor==='');
  h=[U(9,'yes'),J(8,'summary'),U(7,'Book Studio 3 tomorrow 2-4pm, project Y'),J(6,'Which client?'),U(5,'Book Studio F for Japs next Thursday')];
  r=run(h[0],h);
  check('bfd','a newer request without "for" ends the scan',r.bookedFor==='');
  h=[U(9,'Book Studio 3 tomorrow'),U(5,'Book Studio F for Japs next Thursday')];
  r=run(h[0],h,{epoch:'6'});
  check('bfd','nothing before a reset is read',r.bookedFor==='');
  r=run(U(2,'Book Studio F for Japs next Thursday'),[],{broken:true});
  check('bfd','a failure answers "no one" instead of throwing',r.bookedFor===''&&/airtable down/.test(r.error||''));
  r=run({ts:'3',subtype:'message_changed',message:{text:'Book Studio F for Japs next Thursday',user:'UCAMY'}},[]);
  check('bfd','a thread "also send to channel" reply is read from message.text',r.bookedFor==='Japs Concepcion');
  // v162 decision (a): "for <someone not on staff>" is the client
  r=run(U(2,'Book Studio F for Jem Lim next Thursday 1-4pm'),[]);
  check('bfc','"for Jem Lim" (not staff) is the client',r.forClient==='Jem Lim'&&/THE CLIENT IS Jem Lim/.test(r.notice),JSON.stringify(r));
  r=run(U(2,'Book a session for Spotify next Tuesday from 2pm to 5pm'),[]);
  check('bfc','"for Spotify" is the client',r.forClient==='Spotify');
  r=run(U(2,"book Studio 7 next Thursday 2pm to 5pm for Jem Lim's new ad, VO recording, project ORBIT, engineer Tara Lim"),[]);
  check('bfc','a possessive ends the name',r.forClient==='Jem Lim');
  r=run(U(2,'Book Studio F for Japs next Thursday'),[]);
  check('bfc','staff is booked-for, never the client',r.bookedFor==='Japs Concepcion'&&r.forClient==='');
  r=run(U(2,'Book Studio 7 for 2 hours for a VO recording for next Thursday'),[]);
  check('bfc','hours / an article / a date word are not a client',r.forClient==='');
  r=run(U(2,'Book Studio 7 for ORBIT next Friday, project ORBIT'),[]);
  check('bfc','the project named in the message is not the client',r.forClient==='');
  r=run(U(2,'Book Likha for Marketing tomorrow 2-4pm'),[]);
  check('bfc','a department is not a client',r.forClient==='');
  r=run(U(2,'Book Studio 7 for Brightline Media tomorrow, client Brightline Media'),[]);
  check('bfc','an explicit "client X" is left to the model',r.forClient==='');
  r=run(U(2,'Book Studio 7 for Camy tomorrow 2-4pm'),[]);
  check('bfc','the requester is not their own client',r.forClient==='');
  // v162 decision (b): requester text for the new-client check; (d): studios vs rooms
  h=[U(9,'yes'),J(8,'summary... Confirm to book.'),U(7,'client is Brightline Media'),J(6,'Who is the client?'),U(5,'Book Studio 7 tomorrow 2-4pm, VO, project ATLAS')];
  r=run(h[0],h);
  check('bfc','requesterText holds what they typed for this booking',/Brightline Media/.test(r.requesterText)&&/project ATLAS/.test(r.requesterText)&&!/Who is the client/.test(r.requesterText));
  r=run(U(2,'which studios are open next thursday 10am to 1pm?'),[]);
  check('bfc','"which studios" scopes the free list to studios',r.roomScope==='studios');
  r=run(U(2,'What rooms are free next Friday from 2pm to 5pm?'),[]);
  check('bfc','"what rooms" keeps every room',r.roomScope==='all');
});

// ── Engineers and arrangers must be real people in Bookers ────────────────────
