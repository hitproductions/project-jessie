  ];
  const t2=[
    // v185: the move confirmation shows the times that will be used
    ['v185','a move of the booking just made shows 3-5 PM, not the model\'s 3-4','*QAMOVE / Jem Lim / DR* on Wednesday, November 17, 2027 from 3:00 PM – 4:00 PM in Studio 8.\n\nMove it? Reply yes or no.',{bf:{changeJustBooked:true,moveStart:'15:00',moveEnd:'17:00'}},
