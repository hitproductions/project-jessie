#!/usr/bin/env bash
# Run every Code node that holds real logic against a table of scenarios,
# offline, before anything is imported.
#
#   ./scripts/test-nodes                  # newest local file of each workflow
#   ./scripts/test-nodes --live           # pull each workflow from n8n first
#   ./scripts/test-nodes MAIN BOOK CANCEL FIND    # four explicit paths
#
# Covers:
#   Gate Context    (main)          via ./scripts/test-gate
#   Guard Probe     (main)          outgoing text: markers, weekday, vocabulary
#   Check Conflicts (Book Session)  duration note, description and title assembly
#   Check Ownership (Cancel Booking) ownership, title resolution
#   Shape Results   (Find Booking)  shaping, and that `creator` never leaks
#
# Each of these has shipped a bug this weekend that only turned up by reading
# output by hand. A node that decides something belongs in here.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

newest() { ls workflows/$1-v*.json 2>/dev/null | sed 's/.*-v\([0-9]*\)\.json/\1 &/' | sort -n | tail -1 | cut -d' ' -f2; }

if [ "${1:-}" = "--live" ]; then
  set -a; . "$here/.env"; set +a
  api() { curl -sS -H "X-N8N-API-KEY: $N8N_API_KEY" "$N8N_BASE_URL/api/v1/workflows/$1"; }
  api uVVYVB2M7kxpLleI > "$tmp/main.json"
  api EUG3sGXkfsJSYIMz > "$tmp/book.json"
  api bAyDw7udhmY0NL38 > "$tmp/cancel.json"
  api yzirq12O227VTFp8 > "$tmp/find.json"
  api t7lwR2km4tfN8DbM > "$tmp/move.json"
  # 29 Sep: MAIN was left unset here, so the gate check at the end ran on the newest *repo file*, not on live -
  # a candidate in workflows/ made "--live" report the candidate's gate result.
  MAIN="$tmp/main.json"
  echo "testing the live workflows"
elif [ $# -gt 0 ] && [ $# -ne 5 ]; then
  # 2026-09-25: "test-nodes main <file>" used to fall through to the newest repo files and report on
  # THEM, silently - a candidate that was not the newest file was never tested. Refuse instead.
  echo "usage: ./scripts/test-nodes                          (newest file of each workflow in workflows/)" >&2
  echo "       ./scripts/test-nodes --live                   (what n8n has stored)" >&2
  echo "       ./scripts/test-nodes MAIN BOOK CANCEL FIND MOVE (a candidate: all five paths)" >&2
  exit 64
elif [ $# -eq 5 ]; then
  cp "$1" "$tmp/main.json"; cp "$2" "$tmp/book.json"
  cp "$3" "$tmp/cancel.json"; cp "$4" "$tmp/find.json"; cp "$5" "$tmp/move.json"
  MAIN="$1"
  echo "testing $1, $2, $3, $4, $5"
else
  MAIN="$(newest project-jessie)"
  cp "$(newest project-jessie)" "$tmp/main.json"
  cp "$(newest book-session)"   "$tmp/book.json"
  cp "$(newest cancel-booking)" "$tmp/cancel.json"
  cp "$(newest find-booking)"   "$tmp/find.json"
  cp "$(newest move-booking)"   "$tmp/move.json"
  echo "testing $(newest project-jessie), $(newest book-session), $(newest cancel-booking), $(newest find-booking), $(newest move-booking)"
fi
echo

python3 - "$tmp" <<'PY'
import json,sys,os
t=sys.argv[1]
want={"main.json":["Guard Probe","Booked For","Prepared Booking","Prepared Key"],"book.json":["Check Conflicts","Render Summary"],
      "cancel.json":["Check Ownership"],"find.json":["Shape Results"],
      "move.json":["Resolve Booking","Build Recipients"]}
for f,names in want.items():
    w=json.load(open(os.path.join(t,f)))
    for n in w["nodes"]:
        if n["name"] in names:
            open(os.path.join(t,n["name"].replace(" ","_")+".js"),"w").write(n["parameters"]["jsCode"])
    if f=="book.json":
        for n in w["nodes"]:
            if n["name"]=="New Client?":
                e=n["parameters"]["conditions"]["conditions"][0]["leftValue"].strip()
                open(os.path.join(t,"New_Client_expr.js"),"w").write(e[3:-2] if e.startswith("={{") else e)
PY

node - "$tmp" <<'JS'
const fs=require('fs'), path=require('path'), T=process.argv[2];
const src=n=>fs.readFileSync(path.join(T,n.replace(/ /g,'_')+'.js'),'utf8');
let pass=0, fail=0;
const check=(suite,label,cond,detail)=>{
  if(cond){pass++; console.log('  ok    '+label);}
  else {fail++; console.log('  FAIL  '+label+(detail?'  :: '+detail:''));}
};
// A suite that throws must not take the rest of the run with it. Testing an
// older workflow whose node lacks a variable this suite reads is a legitimate
// thing to do - it should report, not crash, or a regression hiding behind the
// first failure is never seen.
const suite=(name,fn)=>{
  console.log(name);
  try { fn(); }
  catch(e){ fail++; console.log('  FAIL  suite could not run :: '+String(e.message).split('\n')[0]); }
  console.log('');
};

// 29 Sep (main v177): Guard Probe sends the confirmation as one line, "Book it? Reply yes or no." Its checks below
// were written against the canonical two-line form, so its output is mapped back to that form before asserting -
// every check keeps its meaning (including the "no confirmation line" ones). scripts/sim-short-marker.js checks
// the one line itself.
const NEG={book:'change anything',cancel:'keep it',move:'keep it where it is'};
const toCanon=o=>{ if(!o||typeof o.output!=='string') return o;
  o.output=o.output.replace(/\n*(Book|Cancel|Move) it\? Reply yes or no\.$/,(w,v)=>{ v=v.toLowerCase(); return '\nReply only with "yes" to '+v+', or "no" to '+NEG[v]+'.\nConfirm to '+v+'.'; }); return o; };
// ── Guard Probe ────────────────────────────────────────────────────────────
suite('Guard Probe — what reaches Slack', ()=>{
  const s=src('Guard Probe');
  // Guard Probe now reads Get Booker (booker line), Gate Context (resolved year,
  // start-only flag), Room Table (the ranking a note is checked against), and
  // probes the tool nodes for isExecuted. ctx lets a case set all of those.
  const ROOMS='- Post Mixing — normally: Studio 7, Studio 8, Studio F, Studio C · also possible: Studio 4, Studio 5, Studio 6\n'
             +'- VO Recording — normally: Studio 7, Studio 8, Studio F, Studio C\n'
             +'- Music Mixing — normally: Studio F · also possible: Studio C';
  const mk=(ctx={})=>name=>{
    if(name==='Get Booker')   return {first:()=>({json:{fields:{Name:'Tara Lim'}}})};
    if(name==='Gate Context') return {first:()=>({json:{datesUnderDiscussion:ctx.dates||'',dateNotice:ctx.dateNotice||'',pastDateNotice:'',declineNotice:ctx.decline||'',
                                                        startOnlyNotice:ctx.startOnly?'THEY GAVE A START TIME AND NO END TIME.':''}})};
    if(name==='Room Table')   return {first:()=>({json:{roomTable:ctx.roomTable===undefined?ROOMS:ctx.roomTable,
                                                        referenceData:JSON.stringify({types:[{type:'VO Recording',min:60,max:180},{type:'Music Vocal Recording',min:60,max:120},{type:'Localization Editing',min:240,max:null}]})}})};
    if(name==='Booked For')   return {first:()=>({json:{bookedFor:ctx.bookedFor||'',requesterText:ctx.requesterText||'',botText:ctx.botText||'',...(ctx.bf||{})}})};
    if(ctx.executed && Object.prototype.hasOwnProperty.call(ctx.executed,name))
      return {isExecuted:ctx.executed[name],first:()=>({json:{}})};
    return {first:()=>({json:{}})};
  };
  const runCtx=(o,ctx={})=>toCanon(new Function('$input','$',s)(
    {first:()=>({json: ctx.steps===undefined?{output:o}:{output:o,intermediateSteps:ctx.steps} })},
    mk(ctx))[0].json);
  const run=o=>runCtx(o,{}).output;
  const t=[
    ['collapses ** to *','**Bold** text',x=>x==='*Bold* text'],
    ['fixes a wrong weekday','*Date:* September 9, 2027 (Wed)',x=>x.includes('(Thu)')],
