    ['v162','"Client: None" without being told is turned into the question','*ORANGE / TL*\n*Client:* None\n*Session Type:* VO Recording\n\nConfirm to book. (yes/no)',
      {requesterText:'Book Studio 7 next Friday 2pm to 4pm, VO recording, project ORANGE, engineer Tara Lim'},x=>!/Confirm to book/.test(x.output)&&/Who is the client/.test(x.output)],
    ['v162','"Client: None" after "no client" stands','*ORANGE / TL*\n*Client:* None\n*Session Type:* VO Recording\n\nConfirm to book. (yes/no)',
