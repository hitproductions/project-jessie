{
  "type": "modal",
  "callback_id": "view",
  "title": {
    "type": "plain_text",
    "text": "Book a room"
  },
  "close": {
    "type": "plain_text",
    "text": "Back"
  },
  "blocks": [
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": "⚠️ *Studio 8 was just booked by someone else* for 2:00–3:00 PM. Pick another room, or go Back to change the time."
      }
    },
    {
      "type": "divider"
    },
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": "🗓️ *Thursday, Oct 15 · 2:00–4:00 PM · VO Recording*"
      }
    },
    {
      "type": "input",
      "block_id": "room",
      "label": {
        "type": "plain_text",
        "text": "Room"
      },
      "element": {
        "type": "radio_buttons",
        "action_id": "room_radio",
        "options": [
          {
            "text": {
              "type": "plain_text",
              "text": "Studio F"
            },
            "value": "Studio F",
            "description": {
              "type": "plain_text",
              "text": "Recommended · usual for VO Recording"
            }
          },
          {
            "text": {
              "type": "plain_text",
              "text": "Studio C"
            },
            "value": "Studio C",
            "description": {
              "type": "plain_text",
              "text": "Usual for VO Recording"
            }
          }
        ],
        "initial_option": {
          "text": {
            "type": "plain_text",
            "text": "Studio F"
          },
          "value": "Studio F",
          "description": {
            "type": "plain_text",
            "text": "Recommended · usual for VO Recording"
          }
        }
      }
    },
    {
      "type": "divider"
    },
    {
      "type": "input",
      "block_id": "project",
      "label": {
        "type": "plain_text",
        "text": "Project"
      },
      "element": {
        "type": "plain_text_input",
        "action_id": "project_in",
        "initial_value": "QAW1"
      }
    },
    {
      "type": "input",
      "block_id": "client",
      "label": {
        "type": "plain_text",
        "text": "Client"
      },
      "element": {
        "type": "plain_text_input",
        "action_id": "client_in",
        "initial_value": "Sasa Abela"
      },
      "optional": true,
      "hint": {
        "type": "plain_text",
        "text": "Did you mean Sasa Abella? Change it, or keep it as typed."
      }
    },
    {
      "type": "context",
      "elements": [
        {
          "type": "mrkdwn",
          "text": "Everything else you entered is kept."
        }
      ]
    }
  ],
  "submit": {
    "type": "plain_text",
    "text": "Book"
  }
}
