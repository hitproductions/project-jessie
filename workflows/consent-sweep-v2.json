    {
      "parameters": {
        "jsCode": "// Consent Sweep (v2, review 29 Sep): every consent request that needs work goes to Finalize SEPARATELY (one\n// sub-run per row, in turn) - a deadline that has passed, or a recorded decision whose Finalize call did not finish.\n// Finalize re-reads each row and decides. MBOOTH timeout still books; PREEMPT timeout still just expires.\nconst now = Date.now(), U = s => String(s || '').toUpperCase().trim();\nreturn $input.all().map(i => (i && i.json) || {}).filter(r => {\n  if (!r['Request ID'] || U(r['Status']) !== 'PENDING') return false;\n  if (U(r['Decision'])) { const at = Date.parse(r['Decision At'] || ''); return !isFinite(at) || now - at > 2 * 60 * 1000; }   // give main / Move's own call time first\n  const dl = Date.parse(r['Deadline'] || ''); return isFinite(dl) && now >= dl;\n}).sort((a, b) => String(a['Request ID']).localeCompare(String(b['Request ID']))).map(r => ({ json: { request_id: r['Request ID'] } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "sweep-decide",
      "name": "Sweep Decide"
    },
