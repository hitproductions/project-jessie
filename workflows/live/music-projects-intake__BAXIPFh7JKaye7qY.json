      {
        "id": "7090420d-8b16-4d7f-a885-41bdc3404c76",
        "name": "Mock Slack Post",
        "parameters": {
          "jsCode": "return [{ json: {\n  channel: 'C0TEST',\n  ts: String(Date.now() / 1000),\n  text: `🎵 NEW MUSIC PROJECT\nQU: QU-99999\nProject Title: TEST Jollibee \"Hapag\"\nFormat / Length: 1x60s TVC, 2x15s Edit Downs\nProduct: Jollibee\nAgency: Ogilvy\nProducer: Sasa Abella\nComposers: Joaquin/BP, Arnold\nTalents: 2 singers\nBid Against: Studio X\nSubmitted by: Letty\nNotes: This is a test post.\nPlease delete after testing.`\n}}];"
        },
        "position": [
          176,
          0
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
      {
        "id": "89e5f3fc-a3fb-4a0e-9b59-1ae8980ebe66",
        "name": "Parse Post",
        "parameters": {
          "jsCode": "let t;\ntry { t = $('Slack Trigger').first().json; }\ncatch (e) { t = $('Mock Slack Post').first().json; }\nconst ev = t.event || t;\nconst text = (ev.text || '').replace(/[*_]/g, '');\n\nconst field = (label) => {\n  const m = text.match(new RegExp('^\\\\s*' + label + '\\\\s*:\\\\s*(.*)$', 'im'));\n  return m ? m[1].trim() : '';\n};\nconst notesMatch = text.match(/^\\s*Notes\\s*:\\s*([\\s\\S]*)$/im);\nconst notes = notesMatch ? notesMatch[1].trim() : '';\n\nconst q = field('QU').match(/QU[\\s-]*(\\d{4,6})/i) || text.match(/QU[\\s-]*(\\d{4,6})/i);\nif (!q) return [];\nconst qu = 'QU-' + q[1];\n\nconst roster = $input.all().map(i => i.json)\n  .filter(r => r['Name'] && String(r['Active']).toLowerCase() === 'yes');\nconst find = (s) => {\n  const id = (s.match(/<@(\\w+)>/) || [])[1];\n  if (id) return roster.find(r => r['Slack User ID'] === id);\n  const n = s.toLowerCase();\n  return roster.find(r => r['Name'].toLowerCase() === n ||\n                          r['Name'].toLowerCase().split(' ')[0] === n);\n};\n\n// \",\" = bidding against each other, \"/\" = collaboration\nconst teams = field('Composers').split(',')\n  .map(entry => entry.split('/').map(s => s.trim()).filter(Boolean)\n    .map(raw => ({ raw, c: find(raw) })))\n  .filter(team => team.length);\n\nconst teamLabel = (team) => team.map(m => m.c ? m.c['Name'] : m.raw).join(' / ');\nconst unknown = teams.flat().filter(m => !m.c).map(m => m.raw);\nconst bidding = teams.length > 1;\n\nconst STATUS = 'ON-GOING';\nconst postedAt = DateTime.fromSeconds(parseFloat(ev.ts)).setZone('Asia/Manila').toFormat('yyyy-MM-dd HH:mm');\nconst now = DateTime.now().setZone('Asia/Manila').toFormat('yyyy-MM-dd HH:mm');\nconst submittedBy = field('Submitted by');\n\nconst assignments = [];\nteams.forEach(team => {\n  const type = team.length > 1 ? 'Collaboration' : 'Solo';\n  team.filter(m => m.c).forEach(m => {\n    assignments.push({\n      'Assignment Key': `${qu}|${m.c['Person ID']}`,\n      'QU': qu,\n      'Composer': m.c['Name'],\n      'Person ID': m.c['Person ID'],\n      'Role': 'COMPOSER',\n      'Assignment Type': type,\n      'Team': teamLabel(team),\n      'Status': bidding ? 'BIDDING' : STATUS,\n      'Assigned At': postedAt,\n      'Assigned By': submittedBy,\n    });\n  });\n});\n\nconst summary = !teams.length ? 'none'\n  : bidding ? 'Bidding: ' + teams.map((tm, i) => `(${i + 1}) ${teamLabel(tm)}`).join('  ·  ')\n  : (teams[0].length > 1 ? 'Collaboration: ' : 'Composer: ') + teamLabel(teams[0]);\n\nreturn [{ json: {\n  channel: ev.channel,\n  ts: ev.ts,\n  unknown,\n  summary,\n  project: {\n    'QU': qu,\n    'DATE POSTED': postedAt,\n    'PROJECT TITLE': field('Project Title'),\n    'FORMAT / LENGTH': field('Format / Length'),\n    'COMPOSER': teams.map(teamLabel).join(', '),\n    'PRODUCER': field('Producer'),\n    'AGENCY': field('Agency'),\n    'PRODUCT': field('Product'),\n    'TALENTS': field('Talents'),\n    'STATUS': STATUS,\n    'BID AGAINST': field('Bid Against'),\n    'NOTES': notes,\n    'Submitted By': submittedBy,\n    'Slack Link': `https://hitproductions.slack.com/archives/${ev.channel}/p${ev.ts.replace('.', '')}`,\n    'Slack TS': ev.ts,\n    'Last Updated': now,\n  },\n  assignments,\n}}];"
        },
