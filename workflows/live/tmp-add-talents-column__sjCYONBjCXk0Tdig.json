      "id": "t3",
      "name": "Plan",
      "parameters": {
        "jsCode": "const NON = ['Form Responses 1','QUERY','DATA VALIDATION','DASHBOARD','QUERY ADJUSTMENTS','TIME LOG','_hitsync'];\nconst sheets = $input.first().json.sheets || [];\nconst tabs = sheets.filter(s => NON.indexOf(s.properties.title) === -1);\n\n// Build batchUpdate requests: for each engineer tab, insert a column at index 11 (L)\nconst insertRequests = tabs.map(s => ({\n  insertDimension: {\n    range: { sheetId: s.properties.sheetId, dimension: 'COLUMNS', startIndex: 11, endIndex: 12 },\n    inheritFromBefore: false\n  }\n}));\n\n// Build values update: write TALENTS header in L1 on each tab\nconst headerData = tabs.map(s => ({\n  range: s.properties.title + '!L1',\n  values: [['TALENTS']]\n}));\n\nreturn [{ json: {\n  batchUrl: 'https://sheets.googleapis.com/v4/spreadsheets/1ExrX8bTBYG64Goq8VKy1JsGkeGUX5rxKbu3sOZ-P1XY:batchUpdate',\n  batchBody: { requests: insertRequests },\n  valuesUrl: 'https://sheets.googleapis.com/v4/spreadsheets/1ExrX8bTBYG64Goq8VKy1JsGkeGUX5rxKbu3sOZ-P1XY/values:batchUpdate',\n  valuesBody: { valueInputOption: 'RAW', data: headerData },\n  tabCount: tabs.length,\n  tabNames: tabs.map(s => s.properties.title)\n} }];"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
