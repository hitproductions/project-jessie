    {
      "parameters": {
        "jsCode": "// Sweep: for each PENDING consent row past its deadline, MBOOTH -> book (via Finalize, timeout=book),\n// PREEMPT/other -> EXPIRE (mark row; never auto-move). sweepAction mirrors mbooth/logic.js (tested).\nfunction sweepAction(row, nowISO){ const status=String((row&&row.Status)||'').toUpperCase(); if(status!=='PENDING') return 'skip'; const _cl=String((row&&row.Claim)||''), _at=Date.parse(_cl.split('@')[1]||''); if(_cl && Number.isFinite(_at) && new Date(nowISO).getTime()-_at<120000) return 'wait'; /* v4 (PENDING 122): an answer is being acted on */ const now=new Date(nowISO).getTime(); const dl=(row&&row.Deadline)?new Date(row.Deadline).getTime():NaN; if(!Number.isFinite(dl)) return 'skip'; if(now<dl) return 'wait'; const kind=String((row&&row.Kind)||'').toUpperCase(); return (kind==='MBOOTH')?'book':'expire'; }\nconst now=new Date().toISOString(); const out=[];\nfor(const it of $input.all()){ const r=(it&&it.json)||{}; if(!r['Request ID']) continue; const a=sweepAction(r, now);\n  if(a==='book'){ out.push({ json: { _sweepAction:'book', _row:r } }); }\n  else if(a==='expire'){ out.push({ json: { 'Request ID':r['Request ID'], 'Status':'EXPIRED', 'Resolved Via':'sweep-expired', 'Decided At':now, _sweepAction:'expire', _row:r /* v3: for its messages */ } }); }\n}\nreturn out;\n"
      },
