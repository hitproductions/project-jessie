    {
      "parameters": {
        "content": "## Jessie — Log Booking\nWrites a booking's rows to the Jessie Log spreadsheet after the reply has gone. Called by Book Session (v112+) without waiting. A failed write never touches the booking.\n\nv2: a Localization / QC project code not in Airtable Localization Projects -> the New Projects tab (For Review).",
        "width": 420
      },
      "id": "6dfb933c-dd5b-4b19-b39f-f1749c1ad261",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        512,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Project Row (v2): a Localization / QC booking's project code, handed over by Book Session (v115+) - none, no item, nothing\n// looked up or written.\nlet r = null; try { r = JSON.parse(String($('When Executed by Another Workflow').first().json.project || '')); } catch (e) { r = null; }\nconst code = r && typeof r === 'object' ? String(r['Code'] || '').trim().toUpperCase() : '';\nreturn code ? [{ json: Object.assign({}, r, { Code: code }) }] : [];"
      },
      "id": "64e92aad-d5a6-4812-b5db-f36af42323e3",
      "name": "Project Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        544
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "cachedResultName": "Project Jessie Knowledge Base",
          "mode": "list",
          "value": "app8GQxEInqJi1NRP"
        },
        "table": {
          "__rl": true,
          "cachedResultName": "Localization Projects",
          "mode": "list",
          "value": "tbljkG6z7odPUtTIf"
        },
        "filterByFormula": "={{ (function(){\n  var c = String(($('Project Row').first().json || {})['Code'] || '').trim().toUpperCase();\n  if (!c) { return 'FALSE()'; }   // gotcha 7: an empty value would match every row\n  return \"UPPER(TRIM({Project Code})) = '\" + c.replace(/'/g, \"\\\\'\") + \"'\";\n})() }}",
        "options": {
          "fields": [
            "Project Code"
          ]
        }
      },
