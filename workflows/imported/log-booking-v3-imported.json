      "parameters": {
        "jsCode": "// New Project? (v2): the code is new only when the lookup answered and found no record. A lookup that errored is not evidence\n// either way - nothing is written.\nconst rows = $('Find Project').all().map(i => i.json || {});\nif (rows.some(r => r.error)) return [];\nif (rows.some(r => r.id)) return [];\nreturn [{ json: $('Project Row').first().json }];"
      },
