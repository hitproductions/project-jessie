    {
      "parameters": {
        "jsCode": "// Finalize Plan - inlined from workflows/drafts/consent/finalize.js (33/33). Computes everything the\n// branches need so downstream nodes only reference $('Plan').\nconst IN = $('When Executed by Another Workflow').first().json || {};\nfunction safeParse(s){ if(s&&typeof s==='object') return s; try{ return JSON.parse(s||''); }catch(_){ return null; } }\nfunction dateOf(iso){ try{ return new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Manila',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(iso)); }catch(_){ return ''; } }\nconst row0 = safeParse(IN.row) || {};\n// v11: the row as the sheet has it now - a request that ended (or was withdrawn) since the caller read it is never placed\nlet fresh = null; try { fresh = $('Read Row').all().map(i => i.json || {}).find(r => r['Request ID'] && String(r['Request ID']) === String(row0['Request ID'])) || null; } catch (e) { fresh = null; }\nconst row = Object.assign({}, row0, fresh || {});\nconst now = new Date().toISOString();\nfunction fail(reason){ return [{ json: { ok:false, reason:reason, rowFail:{ 'Request ID':row['Request ID'], 'Status':'FAILED', 'Resolved Via':reason, 'Decided At':now }, notifyReq:'Sorry - that request could not be completed ('+reason+'). Nothing was changed.', requester:row['Requester']||'' } }]; }\nconst status=String(row['Status']||'').toUpperCase();\nif(['DONE','REJECTED','EXPIRED','FAILED','WITHDRAWN'].indexOf(status)!==-1) return fail('ALREADY_'+status);\nif(!row['Req Start']||!row['Req End']||!row['Room/Booth']) return fail('MISSING_REQ_SLOT');\nconst req=safeParse(row['Req Payload']); if(!req) return fail('BAD_REQ_PAYLOAD');\nconst kind=String(row['Kind']||'').toUpperCase();\n// relocate the incumbent, invoked AS the incumbent (owner=true), confirmed=consent\nconst movePayload={ title:row['Incumbent Title']||'', event_id:row['Incumbent Event Id']||'', booking_date:dateOf(row['Req Start']), new_start_iso:row['Incumbent New Start']||'', new_end_iso:row['Incumbent New End']||'', new_rooms:row['Room/Booth']||'', requester:row['Approver']||'', requester_name:row['Approver Name']||'', confirmed:true, authority:'', department:'' };\n// place the requester: move their booking (kind:move) or a fresh book\nconst placeTarget=(req&&req.kind==='move')?'move':'book';\nconst placePayload = placeTarget==='move'\n  ? { title:req.title||row['Incumbent Title']||'', event_id:req.event_id||'', booking_date:req.booking_date||'', new_start_iso:req.new_start_iso||row['Req Start'], new_end_iso:req.new_end_iso||row['Req End'], new_rooms:req.new_rooms||row['Room/Booth']||'', requester:req.requester||row['Requester']||'', requester_name:req.requester_name||row['Requester Name']||'', confirmed:true, authority:'', department:'' }\n  : Object.assign({}, req, { confirmed:true, room_override:true, rooms:req.rooms||row['Room/Booth']||'', start_iso:req.start_iso||row['Req Start'], end_iso:req.end_iso||row['Req End'] });\nconst rowDone={ 'Request ID':row['Request ID'], 'Status':'DONE', 'Resolved Via':IN.resolvedVia||'', 'Attested By':IN.attestedBy||'', 'Decided At':now };\nconst rowFailMove={ 'Request ID':row['Request ID'], 'Status':'FAILED', 'Resolved Via':'MOVE_FAILED', 'Decided At':now };\nconst rowFailPlace={ 'Request ID':row['Request ID'], 'Status':'FAILED', 'Resolved Via':'PLACE_FAILED', 'Decided At':now };\nconst _isMB = String(row['Kind']||'').toUpperCase()==='MBOOTH';\nfunction whenPhrase(s,e){try{if(/^\\d{4}-\\d{2}-\\d{2}$/.test(String(s||''))){return new Date(s+'T00:00:00+08:00').toLocaleDateString('en-US',{timeZone:'Asia/Manila',month:'short',day:'numeric'})+' (all day)';}const o={timeZone:'Asia/Manila',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'};const a=new Date(s).toLocaleString('en-US',o);const b=e?new Date(e).toLocaleTimeString('en-US',{timeZone:'Asia/Manila',hour:'numeric',minute:'2-digit'}):'';return b?(a+'\\u2013'+b):a;}catch(_){return String(s||'');}}\nconst _when = whenPhrase(row['Req Start'], row['Req End']);\nconst notifyIncumbent = _isMB\n  ? (\"You've offered your \"+row['Room/Booth']+\" booth (\"+_when+\") to \"+(row['Requester Name']||'someone')+\". Thanks for sharing!\")\n  : ('Heads up - your \"'+row['Incumbent Title']+'\" was moved to make room for a higher-priority session in '+row['Room/Booth']+\", as you OK'd. It's now at the time we agreed. Thanks!\");\nconst notifyReqOK = _isMB\n  ? ('Done - '+row['Room/Booth']+' is yours for '+_when+'. '+(row['Approver Name']||'The holder')+\" OK'd sharing the booth.\")\n  : ('Done - '+row['Room/Booth']+' is yours for the requested time. '+row['Approver Name']+' moved their session to make way.');\nconst notifyReqMoveFail=\"Couldn't free \"+row['Room/Booth']+' - '+row['Approver Name']+\"'s session couldn't be moved to the agreed slot, so nothing changed. Want to try another time or room?\";\nconst notifyReqPlaceFail = _isMB\n  ? ((row['Approver Name']||'The holder')+\" OK'd, but I couldn't book \"+row['Room/Booth']+' for you just now. Nothing is double-booked. Please try again.')\n  : (row['Approver Name']+\"'s session was moved, but I couldn't place your booking in \"+row['Room/Booth']+' just now. Nothing is double-booked. Please try again.');\nreturn [{ json: { ok:true, kind:kind, placeTarget:placeTarget, incumbentEventId: row['Incumbent Event Id']||'', movePayload:movePayload, placePayload:placePayload, rowDone:rowDone, rowFailMove:rowFailMove, rowFailPlace:rowFailPlace, notifyIncumbent:notifyIncumbent, notifyReqOK:notifyReqOK, notifyReqMoveFail:notifyReqMoveFail, notifyReqPlaceFail:notifyReqPlaceFail, approver:row['Approver']||'', requester:row['Requester']||'' } }];\n"
      },
